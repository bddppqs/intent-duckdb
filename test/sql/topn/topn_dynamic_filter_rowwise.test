statement ok
ATTACH '__TEST_DIR__/topn_dynamic_filter_rowwise.db' AS rwf

statement ok
SET force_compression = 'rle'

statement ok
CREATE TABLE rwf.runs AS SELECT id, CASE WHEN id < 150000 THEN NULL ELSE (id // 1000)::BIGINT END AS r, (id // 5000)::INTEGER AS s FROM range(400000) t(id)

statement ok
CHECKPOINT rwf

statement ok
RESET force_compression

statement ok
SET threads = 8

# RLE runs, NULL rows in the first segments
