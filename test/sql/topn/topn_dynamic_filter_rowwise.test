# name: test/sql/topn/topn_dynamic_filter_rowwise.test
# description: Top-N bounds applied row by row in the scan: every admitted order type (integers, unsigned, huge, decimals of every width, DATE, TIME, TIMESTAMP and its precisions, TIMESTAMP WITH TIME ZONE) ascending and descending, one and two order keys, OFFSET, NULLS FIRST, NULL rows, ties, a filter on the order column itself and on another column, projections, joins and a null-supplying side, casts, excluded types, an empty and an all-NULL column, a LIMIT above the row count and an RLE-compressed column with an all-NULL segment; the answers are the plain engine answers at threads 8 and 1
# group: [topn]

statement ok
CREATE TABLE rw(id BIGINT, g INTEGER, v VARCHAR, flt DOUBLE, i8 TINYINT, i16 SMALLINT, i32 INTEGER, i64 BIGINT, hi HUGEINT, u8 UTINYINT, u16 USMALLINT, u32 UINTEGER, u64 UBIGINT, uhi UHUGEINT, dec4 DECIMAL(4,1), dec9 DECIMAL(9,2), dec18 DECIMAL(18,3), dec38 DECIMAL(38,4), d DATE, tm TIME, ts TIMESTAMP, ts_s TIMESTAMP_S, ts_ms TIMESTAMP_MS, ts_ns TIMESTAMP_NS, tstz TIMESTAMPTZ)

statement ok
INSERT INTO rw SELECT id, (id % 7)::INTEGER, 'v' || ((id * 7919) % 300000)::VARCHAR, (((id * 7919) % 300000) - 150000) / 8.0, CASE WHEN id % 97 = 1 THEN NULL ELSE (((id * 7919) % 300000) % 256 - 128) END::TINYINT, CASE WHEN id % 97 = 2 THEN NULL ELSE (((id * 7919) % 300000) % 65536 - 32768) END::SMALLINT, CASE WHEN id % 97 = 3 THEN NULL ELSE (((id * 7919) % 300000) * 3 - 450000) END::INTEGER, CASE WHEN id % 97 = 4 THEN NULL ELSE ((((id * 7919) % 300000) - 150000) * 1000000007) END::BIGINT, CASE WHEN id % 97 = 5 THEN NULL ELSE ((((id * 7919) % 300000) - 150000)::HUGEINT * 100000000000000000000) END::HUGEINT, CASE WHEN id % 97 = 6 THEN NULL ELSE (((id * 7919) % 300000) % 256) END::UTINYINT, CASE WHEN id % 97 = 7 THEN NULL ELSE (((id * 7919) % 300000) % 65536) END::USMALLINT, CASE WHEN id % 97 = 8 THEN NULL ELSE (((id * 7919) % 300000) * 7) END::UINTEGER, CASE WHEN id % 97 = 9 THEN NULL ELSE (((id * 7919) % 300000)::UBIGINT * 1000003) END::UBIGINT, CASE WHEN id % 97 = 10 THEN NULL ELSE (((id * 7919) % 300000)::UHUGEINT * 1000000000000000000000) END::UHUGEINT, CASE WHEN id % 97 = 11 THEN NULL ELSE ((((id * 7919) % 300000) % 19999 - 9999) / 10) END::DECIMAL(4,1), CASE WHEN id % 97 = 12 THEN NULL ELSE ((((id * 7919) % 300000) - 150000) / 100) END::DECIMAL(9,2), CASE WHEN id % 97 = 13 THEN NULL ELSE ((((id * 7919) % 300000) - 150000) * 12345.678) END::DECIMAL(18,3), CASE WHEN id % 97 = 14 THEN NULL ELSE ((((id * 7919) % 300000) - 150000)::HUGEINT * 1000000000000000) END::DECIMAL(38,4), CASE WHEN id % 97 = 15 THEN NULL ELSE (DATE '2000-01-01' + (((id * 7919) % 300000) % 20000)::INTEGER) END::DATE, CASE WHEN id % 97 = 16 THEN NULL ELSE (TIME '00:00:00' + to_microseconds(((id * 7919) % 300000) * 250)) END::TIME, CASE WHEN id % 97 = 17 THEN NULL ELSE (TIMESTAMP '2019-07-01 00:00:00' + to_seconds(((id * 7919) % 300000) * 37)) END::TIMESTAMP, CASE WHEN id % 97 = 18 THEN NULL ELSE (TIMESTAMP '2019-07-01 00:00:00' + to_seconds(((id * 7919) % 300000) * 41)) END::TIMESTAMP_S, CASE WHEN id % 97 = 19 THEN NULL ELSE (TIMESTAMP '2019-07-01 00:00:00' + to_milliseconds(((id * 7919) % 300000) * 43)) END::TIMESTAMP_MS, CASE WHEN id % 97 = 20 THEN NULL ELSE (TIMESTAMP '2019-07-01 00:00:00' + to_microseconds(((id * 7919) % 300000) * 47)) END::TIMESTAMP_NS, CASE WHEN id % 97 = 21 THEN NULL ELSE to_timestamp(1561939200 + ((id * 7919) % 300000) * 53) END::TIMESTAMPTZ FROM range(300000) t(id)

statement ok
CREATE TABLE rw_small AS SELECT id, id * 2 AS w FROM range(0, 300000, 1000) t(id)

statement ok
CREATE TABLE rw_empty(id BIGINT, i64 BIGINT)

statement ok
CREATE TABLE rw_nulls AS SELECT id, NULL::BIGINT AS n FROM range(5000) t(id)

statement ok
SET threads = 8

