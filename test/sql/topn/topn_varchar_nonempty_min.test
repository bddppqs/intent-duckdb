# a row group of only '' and NULL ahead of a row group of strings
statement ok
CREATE TABLE e AS SELECT i, CASE WHEN i < 122880 THEN (CASE WHEN i % 3 = 0 THEN NULL ELSE '' END) ELSE 'p' || (i % 1000)::VARCHAR END AS s FROM range(245760) r(i)

statement ok
CHECKPOINT

query I nosort e_asc
SELECT unnest((list(s ORDER BY s))[1:5]) FROM e WHERE s <> ''
----

query I nosort e_asc
SELECT s FROM e WHERE s <> '' ORDER BY s LIMIT 5
----

query I
SELECT count(*) FROM e WHERE s <> '' AND s < 'zzz' AND i < 122880
----
0

query I
SELECT count(*) FROM e WHERE s <> '' AND s < 'zzz'
----
122880

# values sharing their first 8 bytes: the bound's prefix equals every segment's truncated min
statement ok
CREATE TABLE p AS SELECT i, CASE WHEN i % 5 = 0 THEN '' ELSE 'samepref' || chr((65 + ((i * 7) % 26))::INTEGER) || (i % 1000)::VARCHAR END AS s FROM range(368640) r(i)

statement ok
INSERT INTO p VALUES (368640, 'samepref'), (368641, 'sameprefA0'), (368642, 'samepre')

statement ok
CHECKPOINT

query I nosort p_asc
SELECT unnest((list(s ORDER BY s))[1:12]) FROM p WHERE s <> ''
----

query I nosort p_asc
SELECT s FROM p WHERE s <> '' ORDER BY s LIMIT 12
----

query I nosort p_lt
SELECT count(*) FROM p WHERE length(s) > 0 AND s < 'sameprefB'
----

query I nosort p_lt
SELECT count(*) FROM p WHERE s <> '' AND s < 'sameprefB'
----

# unicode strings, and a NOCASE column (NOCASE ties make the chosen rows arbitrary: compared lower-cased, against a Top-N on
# lower(n), which pushes no bound)
statement ok
CREATE TABLE u AS SELECT i, CASE WHEN i % 3 = 0 THEN '' ELSE (['привет ', 'Ярмарка ', 'ёлка ', 'zeta ', 'Alpha '])[1 + (i % 5)] || (i // 997)::VARCHAR END AS s, CASE WHEN i % 3 = 0 THEN '' ELSE (['b', 'B', 'a', 'C', 'c'])[1 + (i % 5)] || (i // 3001)::VARCHAR END AS n FROM range(300000) r(i)

statement ok
CREATE TABLE c (i INTEGER, n VARCHAR COLLATE NOCASE)

statement ok
INSERT INTO c SELECT i, n FROM u

statement ok
CHECKPOINT

query I nosort u_asc
SELECT unnest((list(s ORDER BY s))[1:7]) FROM u WHERE s <> ''
----

query I nosort u_asc
SELECT s FROM u WHERE s <> '' ORDER BY s LIMIT 7
----

query I nosort u_desc
SELECT unnest((list(s ORDER BY s DESC))[1:8]) FROM u WHERE s <> ''
----

query I nosort u_desc
SELECT s FROM u WHERE s <> '' ORDER BY s DESC LIMIT 8
----

query I nosort c_asc
SELECT lower(n) AS x FROM c WHERE n <> '' ORDER BY x LIMIT 10
----

query I nosort c_asc
SELECT lower(n) FROM (SELECT n FROM c WHERE n <> '' ORDER BY n LIMIT 10)
----

# a NOACCENT column (accent-insensitive ties make the chosen rows arbitrary: compared accent-stripped, against a Top-N on
# strip_accents(n), which pushes no bound), after the checkpoint and after a restart
statement ok
CREATE TABLE na (i INTEGER, n VARCHAR COLLATE NOACCENT)

statement ok
INSERT INTO na SELECT i, CASE WHEN i % 3 = 0 THEN '' ELSE (['élan ', 'elan ', 'Ève ', 'eve ', 'àbc '])[1 + (i % 5)] || (i // 997)::VARCHAR END FROM range(300000) r(i)

statement ok
CHECKPOINT

query I nosort na_asc
SELECT strip_accents(n) AS x FROM na WHERE n <> '' ORDER BY x LIMIT 10
----

query I nosort na_asc
SELECT strip_accents(n) FROM (SELECT n FROM na WHERE n <> '' ORDER BY n LIMIT 10)
----

query I nosort na_desc
SELECT strip_accents(n) AS x FROM na WHERE n <> '' ORDER BY x DESC LIMIT 10
----

query I nosort na_desc
SELECT strip_accents(n) FROM (SELECT n FROM na WHERE n <> '' ORDER BY n DESC LIMIT 10)
----

restart

statement ok
SET threads = 8

