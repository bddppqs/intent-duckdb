# name: test/sql/topn/topn_varchar_nonempty_min.test
# description: VARCHAR statistics that keep the minimum non-empty value: a Top-N bound or a range filter beside a `<> ''` (or `> ''`) filter on the same column prunes by it; answers after checkpoint, restart, appends, updates and deletes, a row group of only '' and NULL, values sharing their 8-byte prefix, unicode, NOCASE and DESC each equal the same rows taken by an ordered list aggregate, by a filter the scan cannot narrow (`length(s) > 0`) or, for NOCASE (whose ordered list aggregate orders by bytes), by a Top-N on lower(n)
# group: [topn]

require skip_reload

# a file at the latest storage version: block-compressed, its VARCHAR statistics persisting the non-empty min
load __TEST_DIR__/topn_varchar_nonempty_min.db readwrite latest

statement ok
SET threads = 8

# four row groups: '' every fourth row, NULL every eleventh, otherwise a string whose prefix grows with the row number
statement ok
CREATE TABLE t AS SELECT i, CASE WHEN i % 4 = 0 THEN '' WHEN i % 11 = 0 THEN NULL ELSE 'k' || lpad((i // 2048)::VARCHAR, 5, '0') || ':' || (i % 97)::VARCHAR END AS s FROM range(491520) r(i)

statement ok
CHECKPOINT

# the main header (after the 8-byte block checksum): the magic "DUCK" and the little-endian file version 0x40000002
query II
SELECT substr(hex(content), 17, 8), substr(hex(content), 25, 16) FROM read_blob('__TEST_DIR__/topn_varchar_nonempty_min.db')
----
4455434B	0200004000000000

# pass a: as checkpointed

query I nosort asc_a
SELECT unnest((list(s ORDER BY s))[1:7]) FROM t WHERE s <> ''
----

query I nosort asc_a
SELECT s FROM t WHERE s <> '' ORDER BY s LIMIT 7
----

query I nosort asc_gt_a
SELECT s FROM t WHERE s > '' ORDER BY s LIMIT 9
----

query I nosort asc_gt_a
SELECT unnest((list(s ORDER BY s))[1:9]) FROM t WHERE length(s) > 0
----

query I nosort asc_off_a
SELECT unnest((list(s ORDER BY s))[6:12]) FROM t WHERE s <> ''
----

query I nosort asc_off_a
SELECT s FROM t WHERE s <> '' ORDER BY s LIMIT 7 OFFSET 5
----

query I nosort desc_a
SELECT unnest((list(s ORDER BY s DESC))[1:8]) FROM t WHERE s <> ''
----

query I nosort desc_a
SELECT s FROM t WHERE s <> '' ORDER BY s DESC LIMIT 8
----

query I nosort lt_a
SELECT count(*) FROM t WHERE length(s) > 0 AND s < 'k00010'
----

query I nosort lt_a
SELECT count(*) FROM t WHERE s <> '' AND s < 'k00010'
----

query I nosort ge_a
SELECT count(*) FROM t WHERE length(s) > 0 AND s >= 'k00230'
----

query I nosort ge_a
SELECT count(*) FROM t WHERE s <> '' AND s >= 'k00230'
----

query I nosort eq_a
SELECT count(*) FROM t WHERE length(s) > 0 AND (s = 'k00100:5' OR s = '!upd' OR s = ' late')
----

query I nosort eq_a
SELECT count(*) FROM t WHERE s <> '' AND s IN ('k00100:5', '!upd', ' late')
----

query I nosort below_a
SELECT count(*) FROM t WHERE length(s) > 0 AND s < 'k'
----

query I nosort below_a
SELECT count(*) FROM t WHERE s <> '' AND s < 'k'
----

# pass b: after a restart
restart

statement ok
SET threads = 8


