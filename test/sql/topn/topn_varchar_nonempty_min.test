# appended and updated rows not yet checkpointed: a smaller non-empty value in the last row group and in the appended
# rows, one of the smallest values updated away to ''
statement ok
INSERT INTO t VALUES (491520, ' late'), (491521, ''), (491522, NULL), (491523, 'k00000:0')

statement ok
UPDATE t SET s = '!upd' WHERE i = 400001

statement ok
UPDATE t SET s = '' WHERE i = 1


