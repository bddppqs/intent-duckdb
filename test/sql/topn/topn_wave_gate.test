query I nosort empty_b
SELECT s FROM g WHERE r = 'no-such-tag' ORDER BY s LIMIT 10
----

query I nosort empty_b
SELECT unnest((list(s ORDER BY s))[1:10]) FROM g WHERE r = 'no-such-tag'
----

# liveness: the first ordered row groups are pruned at their zonemap by the range on the order key
query I nosort prune_first_b
SELECT k FROM g WHERE k >= 5999000 ORDER BY k LIMIT 10
----

query I nosort prune_first_b
SELECT unnest((list(k ORDER BY k))[1:10]) FROM g WHERE k >= 5999000
----

# liveness: a single row group
query I nosort one_rg_b
SELECT k FROM one ORDER BY k LIMIT 10
----

query I nosort one_rg_b
SELECT unnest((list(k ORDER BY k))[1:10]) FROM one
----

statement ok
SET threads = 1

query I nosort late_b
SELECT s FROM g WHERE s <> '' ORDER BY s LIMIT 10
----

statement ok
SET threads = 8

statement ok
PRAGMA verify_parallelism

query I nosort late_b
SELECT s FROM g WHERE s <> '' ORDER BY s LIMIT 10
----

statement ok
