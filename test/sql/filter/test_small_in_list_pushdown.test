require parquet

statement ok
COPY (SELECT * FROM sil) TO '__TEST_DIR__/test_small_in_list_pushdown.parquet' (FORMAT parquet)

statement ok
SET threads = 8

# a parquet scan
query II
SELECT count(*), sum(id) FROM read_parquet('__TEST_DIR__/test_small_in_list_pushdown.parquet') WHERE s IN (-1, 6)
----
29121	3640003608

query II
SELECT count(*), sum(id) FROM read_parquet('__TEST_DIR__/test_small_in_list_pushdown.parquet') WHERE s = 2 OR s = 9
----
29121	3640180017

query II
SELECT count(*), sum(id) FROM read_parquet('__TEST_DIR__/test_small_in_list_pushdown.parquet') WHERE v IN ('c', 'd', 'e')
----
67415	8426783540

