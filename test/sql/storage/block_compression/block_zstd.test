# name: test/sql/storage/block_compression/block_zstd.test
# description: Blocks of a file created at the latest storage version are stored zstd-compressed (file version 0x40000005)
# group: [block_compression]

require skip_reload

# the same data in a compressed file (latest) and an uncompressed one (v1.4.0)
statement ok
ATTACH '__TEST_DIR__/block_zstd_new.db' AS cnew (STORAGE_VERSION 'latest')

statement ok
ATTACH '__TEST_DIR__/block_zstd_old.db' AS cold (STORAGE_VERSION 'v1.4.0')

statement ok
CREATE TABLE cnew.t AS SELECT i, i % 1000 AS g, 'value-' || (i % 5000)::VARCHAR AS s, (i * 7919) % 1000003 AS r,
    CASE WHEN i % 3 = 0 THEN NULL ELSE i::DOUBLE / 7 END AS d FROM range(1048576) t(i)

statement ok
CREATE TABLE cold.t AS FROM cnew.t

statement ok
CHECKPOINT cnew

statement ok
CHECKPOINT cold

query IIIII
SELECT count(*), sum(i) % 1000000007, count(DISTINCT s), sum(r) % 1000000007, sum(d)::BIGINT FROM cnew.t
----
1048576	755285757	5000	275414320	52357596696

statement ok
DETACH cnew

statement ok
DETACH cold

# the compressed file is smaller
query I
SELECT (SELECT size FROM read_blob('__TEST_DIR__/block_zstd_new.db')) < (SELECT size FROM read_blob('__TEST_DIR__/block_zstd_old.db'))
----
true

# both read back
statement ok
ATTACH '__TEST_DIR__/block_zstd_new.db' AS cnew

statement ok
ATTACH '__TEST_DIR__/block_zstd_old.db' AS cold

query IIIII
SELECT count(*), sum(i) % 1000000007, count(DISTINCT s), sum(r) % 1000000007, sum(d)::BIGINT FROM cnew.t
----
1048576	755285757	5000	275414320	52357596696

query I
SELECT count(*) FROM (FROM cnew.t EXCEPT ALL FROM cold.t)
----
0

# updates, deletes and appends, checkpointed and read back after a re-attach
statement ok
UPDATE cnew.t SET s = 'updated' WHERE i % 97 = 0

statement ok
DELETE FROM cnew.t WHERE i % 89 = 0

statement ok
INSERT INTO cnew.t SELECT i, i % 1000, 'appended-' || i::VARCHAR, i, NULL FROM range(1048576, 1148576) t(i)

statement ok
CHECKPOINT cnew

statement ok
DETACH cnew

statement ok
ATTACH '__TEST_DIR__/block_zstd_new.db' AS cnew

query III
SELECT count(*), count(*) FILTER (WHERE s = 'updated'), count(*) FILTER (WHERE s LIKE 'appended-%') FROM cnew.t
----
1136794	10689	100000

# a dropped table frees its blocks; a new table written after the drop reads back
statement ok
DROP TABLE cnew.t

statement ok
CREATE TABLE cnew.u AS SELECT i, i::VARCHAR AS s FROM range(300000) t(i)

statement ok
CHECKPOINT cnew

statement ok
DETACH cnew

# batch reads (prefetch) go through the extent map one block at a time
statement ok
SET storage_block_prefetch='debug_force_always'

statement ok
ATTACH '__TEST_DIR__/block_zstd_new.db' AS cnew (READ_ONLY)

query II
SELECT count(*), sum(length(s)) FROM cnew.u
----
300000	1688890

statement ok
DETACH cnew

# the main header (after the 8-byte block checksum) holds the magic "DUCK" and the little-endian file version
# 0x40000005 (the format-riders version), outside upstream's sequential storage-version range; the
# v1.4.0 file keeps upstream's 67
query II
SELECT substr(hex(content), 17, 8), substr(hex(content), 25, 16) FROM read_blob('__TEST_DIR__/block_zstd_new.db')
----
4455434B	0500004000000000

query II
SELECT substr(hex(content), 17, 8), substr(hex(content), 25, 16) FROM read_blob('__TEST_DIR__/block_zstd_old.db')
----
4455434B	4300000000000000

# an older storage version stays uncompressed and readable
query II
SELECT count(*), sum(i) % 1000000007 FROM cold.t
----
1048576	755285757

# a table dropped and a new one written in its place, checkpointed and read back
statement ok
ATTACH '__TEST_DIR__/block_zstd_new.db' AS cnew

statement ok
CREATE TABLE cnew.v AS SELECT i, (i * 3)::VARCHAR AS s FROM range(400000) t(i)

statement ok
DROP TABLE cnew.u

statement ok
CREATE TABLE cnew.u2 AS SELECT i, i::VARCHAR AS s FROM range(300000) t(i)

statement ok
CHECKPOINT cnew

statement ok
DETACH cnew

statement ok
ATTACH '__TEST_DIR__/block_zstd_new.db' AS cnew (READ_ONLY)

query IIII
SELECT (SELECT count(*) FROM cnew.v), (SELECT sum(length(s)) FROM cnew.v), (SELECT count(*) FROM cnew.u2), (SELECT sum(length(s)) FROM cnew.u2)
----
400000	2429626	300000	1688890

statement ok
DETACH cnew

# optimistically written blocks the WAL references (no checkpoint before the restart) are found at the restart
statement ok
SET storage_block_prefetch='remote_only'

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
ATTACH '__TEST_DIR__/block_zstd_wal.db' AS cwal (STORAGE_VERSION 'latest')

statement ok
CREATE TABLE cwal.w AS SELECT i, 'wal-' || i::VARCHAR AS s FROM range(1000000) t(i)

statement ok
INSERT INTO cwal.w SELECT i, 'more-' || i::VARCHAR FROM range(1000000, 1500000) t(i)

statement ok
DETACH cwal

statement ok
ATTACH '__TEST_DIR__/block_zstd_wal.db' AS cwal (READ_ONLY)

query III
SELECT count(*), sum(i), count(*) FILTER (WHERE s LIKE 'more-%') FROM cwal.w
----
1500000	1124999250000	500000

statement ok
DETACH cwal

statement ok
PRAGMA enable_checkpoint_on_shutdown

statement ok
SET checkpoint_threshold='16MB'

statement ok
ATTACH '__TEST_DIR__/block_zstd_wal.db' AS cwal

query II
SELECT count(*), sum(i) FROM cwal.w
----
1500000	1124999250000

statement ok
CHECKPOINT cwal

statement ok
DETACH cwal

statement ok
ATTACH '__TEST_DIR__/block_zstd_wal.db' AS cwal (READ_ONLY)

query II
SELECT count(*), sum(length(s)) FROM cwal.w
----
1500000	15888890

statement ok
DETACH cwal

# the zstd level is the setting zstd_block_compression_level (default 0 = automatic, 1 to 22): the same data written at level 12
# is smaller than at level 1, and both read back the same
query I
SELECT current_setting('zstd_block_compression_level')
----
0

statement error
SET zstd_block_compression_level = 23
----
between 1 and 22

statement ok
SET zstd_block_compression_level = 1

statement ok
ATTACH '__TEST_DIR__/block_zstd_level1.db' AS c1 (STORAGE_VERSION 'latest')

statement ok
CREATE TABLE c1.t AS FROM cold.t

statement ok
CHECKPOINT c1

statement ok
DETACH c1

statement ok
SET zstd_block_compression_level = 12

statement ok
ATTACH '__TEST_DIR__/block_zstd_level12.db' AS c12 (STORAGE_VERSION 'latest')

statement ok
CREATE TABLE c12.t AS FROM cold.t

statement ok
CHECKPOINT c12

statement ok
DETACH c12

statement ok
RESET zstd_block_compression_level

query I
SELECT current_setting('zstd_block_compression_level')
----
0

query I
SELECT (SELECT size FROM read_blob('__TEST_DIR__/block_zstd_level12.db')) < (SELECT size FROM read_blob('__TEST_DIR__/block_zstd_level1.db'))
----
true

statement ok
ATTACH '__TEST_DIR__/block_zstd_level1.db' AS c1 (READ_ONLY)

statement ok
ATTACH '__TEST_DIR__/block_zstd_level12.db' AS c12 (READ_ONLY)

query II
SELECT (SELECT count(*) FROM (FROM c1.t EXCEPT ALL FROM cold.t)), (SELECT count(*) FROM (FROM c12.t EXCEPT ALL FROM cold.t))
----
0	0

query II
SELECT count(*), sum(i) % 1000000007 FROM c12.t
----
1048576	755285757
