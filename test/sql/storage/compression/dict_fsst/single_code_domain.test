# name: test/sql/storage/compression/dict_fsst/single_code_domain.test
# description: The single-code filter path under a domain verdict: persistent DICT_FSST- and DICTIONARY-mode segments whose dictionary has one failing (<> '') or one passing (=) entry, with the domain verdict on (constant filters, a same-column AND, a TopN whose dynamic bound tightens the domain away from the shape) and off (LIKE / NOT LIKE with an inner wildcard, a canonical LIKE, an OR with IS NULL), NULL rows, a two-entry dictionary and segments starting inside a vector (per-vector survivors); each query twice at threads 1 and 8; the answers are the plain engine answers
# group: [dict_fsst]

# The straddling segments this test writes need the unaligned DICT_FSST writer, so it runs only in a build with
# kVectorAlignedDictionarySegments off (the default writer ends every segment on a vector boundary). In the default
# build, dict_fsst_straddled_segments_read.test reaches the same scan paths on a checked-in straddled file.
require unaligned_dictionary_segments

require vector_size 2048

load {TEST_DIR}/single_code_domain.db readwrite v1.5.0

statement ok
PRAGMA force_compression='dict_fsst'

# t_sc: 300000 rows (three row groups); s DICT_FSST mode ('' every 89th row, 'hot' every 13th, NULL every 97th, else 'v' || md5), d DICTIONARY mode ('' every 7th, NULL every 101st, else d00..d19), o a two-entry dictionary
statement ok
CREATE TABLE t_sc AS SELECT i::BIGINT AS i, CASE WHEN i % 97 = 0 THEN NULL WHEN i % 89 = 0 THEN '' WHEN i % 13 = 0 THEN 'hot' ELSE 'v' || md5(i::VARCHAR) END AS s, CASE WHEN i % 101 = 0 THEN NULL WHEN i % 7 = 0 THEN '' ELSE 'd' || lpad((i % 20)::VARCHAR, 2, '0') END AS d, CASE WHEN i % 3 = 0 THEN NULL ELSE 'only' END AS o FROM range(300000) tbl(i)

statement ok
CHECKPOINT

restart

# the geometry, read from storage_info (never inferred): s in DICT_FSST mode, many segments starting inside a vector (straddling vectors); d and o in DICTIONARY mode
query I
SELECT count(*) > 20 AND bool_and(compression = 'DICT_FSST') AND bool_and(segment_info LIKE 'DICT_FSST:%') FROM pragma_storage_info('t_sc') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
true

query I
SELECT count(*) > 10 FROM pragma_storage_info('t_sc') WHERE column_name = 's' AND segment_type = 'VARCHAR' AND start > 0 AND start % 2048 <> 0
----
true

query I
SELECT count(*) > 0 AND bool_and(compression = 'DICT_FSST' AND segment_info LIKE 'DICTIONARY:%') FROM pragma_storage_info('t_sc') WHERE column_name = 'd' AND segment_type = 'VARCHAR'
----
true

query I
SELECT count(*) > 0 AND bool_and(compression = 'DICT_FSST' AND segment_info LIKE 'DICTIONARY:%') FROM pragma_storage_info('t_sc') WHERE column_name = 'o' AND segment_type = 'VARCHAR'
----
true

loop t 0 2

statement ok
SET threads = CASE WHEN ${t} = 0 THEN 1 ELSE 8 END

loop r 0 2

# <> '' - one failing entry in every s segment's DICT_FSST dictionary, the domain verdict on (a constant filter)
query IIIII
SELECT count(*), count(s), min(s), max(s), sum(i) FROM t_sc WHERE s <> ''
----
293571	293571	hot	vfffffe98d0963d27015c198262d97221	44035622154

# = 'hot' - one passing entry, the domain verdict on
query IIIII
SELECT count(*), count(s), min(s), max(s), sum(i) FROM t_sc WHERE s = 'hot'
----
22582	22582	hot	hot	3387228052

# the same-column conjunction <> '' AND = 'hot' - one passing entry, the domain walked over the AND
query IIIII
SELECT count(*), count(s), min(s), max(s), sum(i) FROM t_sc WHERE s <> '' AND s = 'hot'
----
22582	22582	hot	hot	3387228052

# <> 'absent' - every entry passes (no single-code shape)
query IIIII
SELECT count(*), count(s), min(s), max(s), sum(i) FROM t_sc WHERE s <> 'absent'
----
296907	296907	(empty)	vfffffe98d0963d27015c198262d97221	44536017534

# = 'absent' - no entry passes (the segment skipped by the domain)
query IIIII
SELECT count(*), count(s), min(s), max(s), sum(i) FROM t_sc WHERE s = 'absent'
----
0	0	NULL	NULL	NULL

# LIKE '%h_t%' (inner wildcard, never canonical) - one passing entry, the domain verdict off (an expression filter)
query IIIII
SELECT count(*), count(s), min(s), max(s), sum(i) FROM t_sc WHERE s LIKE '%h_t%'
----
22582	22582	hot	hot	3387228052

# NOT LIKE '%h_t%' - one failing entry, the domain verdict off
query IIIII
SELECT count(*), count(s), min(s), max(s), sum(i) FROM t_sc WHERE s NOT LIKE '%h_t%'
----
274325	274325	(empty)	vfffffe98d0963d27015c198262d97221	41148789482

# LIKE '%ho%' (canonical contains: the per-segment dictionary skip and the verdict cache slot) - one passing entry, the domain verdict off
query IIIII
SELECT count(*), count(s), min(s), max(s), sum(i) FROM t_sc WHERE s LIKE '%ho%'
----
22582	22582	hot	hot	3387228052

# IS NULL OR <> '' - one failing entry and the NULL slot passing (an OR, the domain walk unsupported)
query IIIII
SELECT count(*), count(s), min(s), max(s), sum(i) FROM t_sc WHERE s IS NULL OR s <> ''
----
296664	293571	hot	vfffffe98d0963d27015c198262d97221	44499454620

# IS NULL OR = 'hot' - one passing entry and the NULL slot passing
query IIIII
SELECT count(*), count(s), min(s), max(s), sum(i) FROM t_sc WHERE s IS NULL OR s = 'hot'
----
25675	22582	hot	hot	3851060518

# <> '' on the DICTIONARY-mode column, NULLs present, the domain verdict on
query IIIII
SELECT count(*), count(d), min(d), max(d), sum(i) FROM t_sc WHERE d <> ''
----
254596	254596	d00	d19	38189266694

# = 'd05' on the DICTIONARY-mode column
query IIIII
SELECT count(*), count(d), min(d), max(d), sum(i) FROM t_sc WHERE d = 'd05'
----
12729	12729	d05	d05	1909222905

# LIKE '%1_%' on the DICTIONARY-mode column (never canonical, the domain verdict off)
query IIIII
SELECT count(*), count(d), min(d), max(d), sum(i) FROM t_sc WHERE d LIKE '%1_%'
----
127301	127301	d10	d19	19095532427

# <> 'other' on a two-entry dictionary (the NULL slot and 'only'): one passing entry, the NULL slot failing
query IIIII
SELECT count(*), count(o), min(o), max(o), sum(i) FROM t_sc WHERE o <> 'other'
----
200000	200000	only	only	30000000000

# = 'only' on the two-entry dictionary
query IIIII
SELECT count(*), count(o), min(o), max(o), sum(i) FROM t_sc WHERE o = 'only'
----
200000	200000	only	only	30000000000

# <> 'only' on the two-entry dictionary: no entry passes
query IIIII
SELECT count(*), count(o), min(o), max(o), sum(i) FROM t_sc WHERE o <> 'only'
----
0	0	NULL	NULL	NULL

# the survivors of every vector under <> '' (whole vectors and the straddling ones): vector:count:sum(i)
query I
SELECT string_agg(v::VARCHAR || ':' || c::VARCHAR || ':' || sm::VARCHAR, ',' ORDER BY v) FROM (SELECT i // 2048 AS v, count(*) AS c, sum(i) AS sm FROM t_sc WHERE s <> '' GROUP BY v)
