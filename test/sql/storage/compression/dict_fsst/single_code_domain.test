# a TopN on the filtered column (the dynamic bound tightens the domain away from filter_result's shape)
query I
SELECT string_agg(i::VARCHAR || '=' || s, ',' ORDER BY s, i) FROM (SELECT i, s FROM t_sc WHERE s <> '' ORDER BY s, i LIMIT 5)
----
13=hot,26=hot,39=hot,52=hot,65=hot

# a descending TopN on the filtered column
query I
SELECT string_agg(i::VARCHAR || '=' || s, ',' ORDER BY s DESC, i) FROM (SELECT i, s FROM t_sc WHERE s <> '' ORDER BY s DESC, i LIMIT 5)
----
40691=vfffffe98d0963d27015c198262d97221,95102=vffffda8ada4827900cbf65fd20281080,233443=vffffb8de2d77567f452ad766471a9e5e,177425=vffff748a7ac35759d9fef57a34fd4a21,262349=vffff31b8d1dd1486a7fe6914761aa655

# a TopN on the DICTIONARY-mode column
query I
SELECT string_agg(i::VARCHAR || '=' || d, ',' ORDER BY d, i) FROM (SELECT i, d FROM t_sc WHERE d <> '' ORDER BY d, i LIMIT 5)
----
20=d00,40=d00,60=d00,80=d00,100=d00

# grouped by the filtered DICTIONARY-mode column
query I
SELECT string_agg(d || ':' || c::VARCHAR, ',' ORDER BY d) FROM (SELECT d, count(*) AS c FROM t_sc WHERE d <> '' GROUP BY d)
----
d00:12730,d01:12730,d02:12729,d03:12729,d04:12729,d05:12729,d06:12730,d07:12730,d08:12730,d09:12729,d10:12729,d11:12730,d12:12730,d13:12731,d14:12731,d15:12730,d16:12730,d17:12730,d18:12730,d19:12730

# two single-code filters on two columns (the second one sees a selection: the verdict loop)
query II
SELECT count(*), sum(i) FROM t_sc WHERE s <> '' AND d <> ''
----
249141	37371112754

endloop

endloop
