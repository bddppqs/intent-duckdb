# name: test/sql/storage/compression/dict_fsst/dict_global_build.test
# description: The global column dictionary built from DICT_FSST segments answers as the per-segment scan
# group: [dict_fsst]

# The column dictionaries are built at the first scan of a DICT_FSST column and published once; every answer equals the per-segment scan

statement ok
ATTACH '__TEST_DIR__/dict_global_build.db' AS globaldict (STORAGE_VERSION 'v1.5.0')

statement ok
USE globaldict

statement ok
SET force_compression='dict_fsst'

statement ok
CREATE TABLE docs AS SELECT i AS id, (i % 13)::SMALLINT AS cat, (hash(i) % 5000)::BIGINT AS owner, CASE WHEN i % 97 = 0 THEN NULL ELSE 'https://www.example.org/globaldict/some/long/path/' || (hash(i // 3) % 20000)::VARCHAR END AS addr, CASE WHEN i % 5 = 0 THEN '' ELSE 'catalogue item number ' || (hash(i // 2) % 3000)::VARCHAR END AS word, 'topic-of-the-page-number-' || (i % 211)::VARCHAR AS label FROM range(400000) r(i)

statement ok
CHECKPOINT

# first scans build; later scans read the published dictionaries (straddling and partial vectors included: 400,000 rows are four row groups, the last one partial)

query IIIII
SELECT count(*), count(addr), count(DISTINCT addr), count(DISTINCT word), count(DISTINCT label) FROM docs
----
400000	395876	19979	3001	211

query IIIII
SELECT min(addr), max(addr), sum(length(addr)), min(label), max(word) FROM docs
----
https://www.example.org/globaldict/some/long/path/0	https://www.example.org/globaldict/some/long/path/9999	21552899	topic-of-the-page-number-0	catalogue item number 999

query I
SELECT count(*) FROM docs WHERE word <> ''
----
320000

query II
SELECT count(*), count(DISTINCT addr) FROM docs WHERE addr LIKE '%path/12%'
----
21991	1109

query II
SELECT addr, id FROM docs WHERE id IN (0, 1, 97, 122879, 122880, 245759, 245760, 399999) ORDER BY id
----
NULL	0
https://www.example.org/globaldict/some/long/path/0	1
NULL	97
https://www.example.org/globaldict/some/long/path/4617	122879
https://www.example.org/globaldict/some/long/path/16500	122880
https://www.example.org/globaldict/some/long/path/8408	245759
https://www.example.org/globaldict/some/long/path/1653	245760
https://www.example.org/globaldict/some/long/path/139	399999

query I
SELECT count(*) FROM docs WHERE addr IS NULL
----
4124

query III
SELECT sum(hash(addr)), sum(hash(word)), sum(hash(label)) FROM docs
----
3721444363901467728954247	3354364643939063083713286	3801903340289146262219720

query IIIII
SELECT count(*), count(addr), count(DISTINCT addr), count(DISTINCT word), count(DISTINCT label) FROM docs
----
400000	395876	19979	3001	211

query IIIII
SELECT min(addr), max(addr), sum(length(addr)), min(label), max(word) FROM docs
----
https://www.example.org/globaldict/some/long/path/0	https://www.example.org/globaldict/some/long/path/9999	21552899	topic-of-the-page-number-0	catalogue item number 999

query I
SELECT count(*) FROM docs WHERE word <> ''
----
320000

query II
SELECT count(*), count(DISTINCT addr) FROM docs WHERE addr LIKE '%path/12%'
----
21991	1109

query II
SELECT addr, id FROM docs WHERE id IN (0, 1, 97, 122879, 122880, 245759, 245760, 399999) ORDER BY id
----
NULL	0
https://www.example.org/globaldict/some/long/path/0	1
NULL	97
https://www.example.org/globaldict/some/long/path/4617	122879
https://www.example.org/globaldict/some/long/path/16500	122880
https://www.example.org/globaldict/some/long/path/8408	245759
https://www.example.org/globaldict/some/long/path/1653	245760
https://www.example.org/globaldict/some/long/path/139	399999

query I
SELECT count(*) FROM docs WHERE addr IS NULL
----
4124

query III
SELECT sum(hash(addr)), sum(hash(word)), sum(hash(label)) FROM docs
----
3721444363901467728954247	3354364643939063083713286	3801903340289146262219720

# a column with updates scans flat; rows appended after the build take the per-segment path

statement ok
UPDATE docs SET label = 'an updated topic of this page' WHERE id % 1000 = 7

statement ok
INSERT INTO docs SELECT 400000 + i, 1, 1, 'https://www.example.org/globaldict/some/long/path/' || 'appended-' || (i % 10)::VARCHAR, 'a new word ' || i::VARCHAR, 'a new topic of the page' FROM range(5000) r(i)

query IIII
SELECT count(*), count(DISTINCT addr), count(DISTINCT label), count(DISTINCT word) FROM docs
----
405000	19989	213	8001

query II
SELECT label, count(*) FROM docs WHERE label LIKE '%updated%' OR label LIKE '%new topic%' GROUP BY label ORDER BY label
----
a new topic of the page	5000
an updated topic of this page	400

statement ok
CHECKPOINT

query IIII
SELECT count(*), count(DISTINCT addr), count(DISTINCT label), sum(hash(addr)) FROM docs
----
405000	19989	213	3766382426887637496479247

query IIII
SELECT count(*), count(DISTINCT addr), count(DISTINCT label), sum(hash(addr)) FROM docs
----
405000	19989	213	3766382426887637496479247

# a dropped and re-created table builds a new dictionary under a new id (the expression memo)

query I
SELECT count(DISTINCT regexp_replace(label, '[0-9]+', 'N')) FROM docs
----
3

statement ok
DROP TABLE docs

statement ok
CREATE TABLE docs AS SELECT i AS id, (i % 13)::SMALLINT AS cat, (hash(i) % 5000)::BIGINT AS owner, CASE WHEN i % 97 = 0 THEN NULL ELSE 'https://www.example.org/globaldict/some/long/path/' || (hash(i // 3) % 20000)::VARCHAR END AS addr, CASE WHEN i % 5 = 0 THEN '' ELSE 'catalogue item number ' || (hash(i // 2) % 3000)::VARCHAR END AS word, 'another-topic-of-the-page-' || (i % 211)::VARCHAR AS label FROM range(150000) r(i)

statement ok
CHECKPOINT

query II
SELECT count(DISTINCT regexp_replace(label, '[0-9]+', 'N')), min(label) FROM docs
----
1	another-topic-of-the-page-0

query II
SELECT count(DISTINCT regexp_replace(label, '[0-9]+', 'N')), min(label) FROM docs
----
1	another-topic-of-the-page-0

