# an updated word is not a dictionary entry: its segment must not be pruned
statement ok
UPDATE t SET s = 'a-updated' WHERE i = 150000

query I
SELECT s FROM t WHERE s <> '' ORDER BY s LIMIT 1
----
a-updated

statement ok
DELETE FROM t WHERE i = 150000

query I
SELECT count(*) FROM ((SELECT s FROM t WHERE s <> '' ORDER BY s LIMIT 10) EXCEPT ALL (SELECT unnest(min(s, 10)) FROM t WHERE s <> ''))
----
0

# a pending update on a DICTIONARY-mode segment and on the later-segment table is never pruned
statement ok
UPDATE t_dm_bound SET s = 'a-updated' WHERE i = 200000

query I
SELECT s FROM t_dm_bound WHERE s <> '' ORDER BY s LIMIT 1
----
a-updated

statement ok
UPDATE t_zone SET s = 'a-updated' WHERE g = 70000

query I
SELECT s FROM t_zone WHERE s <> '' ORDER BY s LIMIT 2
----
a-updated
a:102400
