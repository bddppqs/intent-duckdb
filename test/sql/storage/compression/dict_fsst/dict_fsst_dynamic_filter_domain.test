# name: test/sql/storage/compression/dict_fsst/dict_fsst_dynamic_filter_domain.test
# description: TopN dynamic filter evaluated on DICT_FSST dictionary domains: segments whose dictionary holds no word that can beat the running bound are skipped whole at every segment position, in DICT_FSST and DICTIONARY mode; the segment skip target is the vector holding the segment's end; answers are unchanged
# group: [dict_fsst]

load {TEST_DIR}/dict_fsst_dynamic_filter_domain.db readwrite v1.5.0

statement ok
PRAGMA force_compression='dict_fsst'

# t: every 7th word is '', the others are a permutation of v000000..v299999 (40507 is coprime with 300000)
statement ok
CREATE TABLE t AS
SELECT i::BIGINT AS i,
       CASE WHEN i % 7 = 0 THEN '' ELSE 'v' || lpad(((i * 40507) % 300000)::VARCHAR, 6, '0') END AS s,
       (i % 1000)::INTEGER AS k
FROM range(300000) tbl(i)

# t_head: a whole 122,880-row row group of '' (one segment without a word that passes s <> ''), then v-values
statement ok
CREATE TABLE t_head AS
SELECT i::BIGINT AS i, CASE WHEN i < 122880 THEN '' ELSE 'v' || lpad(i::VARCHAR, 6, '0') END AS s
FROM range(250000) tbl(i)

# t_null: NULL words mixed in (slot zero of every dictionary is referenced)
statement ok
CREATE TABLE t_null AS
SELECT i::BIGINT AS i,
       CASE WHEN i % 5 = 0 THEN NULL WHEN i % 7 = 0 THEN '' ELSE 'v' || lpad(((i * 40507) % 300000)::VARCHAR, 6, '0') END AS s
FROM range(300000) tbl(i)

# t_small: fewer non-empty words (9) than the limit, so the bound is never set
statement ok
CREATE TABLE t_small AS
SELECT i::BIGINT AS i, CASE WHEN i < 9 THEN 'v' || i::VARCHAR ELSE '' END AS s
FROM range(5000) tbl(i)

# DICTIONARY-mode tables (dictionaries far below the 4,096-byte TryEncode threshold): an all-NULL dictionary, a single
# non-empty value after a '' prefix, an all-equal column, and dictionaries whose entries meet the bound: k00..k08 occur
# once each (k05..k08 in row group 0, k00..k04 in row group 2) and k09 many times in every row group, so the final bound
# is k09, row group 1's dictionary {'', k09} has its smallest non-empty entry equal to the bound and row group 2's
# dictionary {'', k00..k04, k09} has its largest entry equal to the bound
statement ok
CREATE TABLE t_dm_allnull AS SELECT i::BIGINT AS i, NULL::VARCHAR AS s FROM range(5000) tbl(i)

statement ok
CREATE TABLE t_dm_one AS SELECT i::BIGINT AS i, CASE WHEN i = 4999 THEN 'only-one' ELSE '' END AS s FROM range(5000) tbl(i)

statement ok
CREATE TABLE t_dm_alleq AS SELECT i::BIGINT AS i, 'same' AS s FROM range(100000) tbl(i)

statement ok
CREATE TABLE t_dm_bound AS
SELECT i::BIGINT AS i,
       CASE WHEN i < 122880 THEN (CASE WHEN i BETWEEN 100 AND 103 THEN 'k' || lpad((i - 95)::VARCHAR, 2, '0') WHEN i % 97 = 0 THEN 'k09' ELSE '' END)
            WHEN i < 245760 THEN (CASE WHEN i % 2 = 0 THEN 'k09' ELSE '' END)
            ELSE (CASE WHEN i BETWEEN 245860 AND 245864 THEN 'k' || lpad((i - 245860)::VARCHAR, 2, '0') WHEN i % 89 = 0 THEN 'k09' ELSE '' END) END AS s
FROM range(368640) tbl(i)

# t_zone: exactly one row group; g = the row number in four 32,767-row uncompressed segments (starts 0 / 32767 / 65534 /
# 98301); s in three regions: rows 0-20479 '' every 7th row else 64-character m:-values (a new value every 3 rows),
# rows 20480-102399 z:-values, rows 102400-122879 'a:' || lpad(i, 6, '0') every 5th row else q:-values. A segment pruned
# by the statistics or the domain check is immediately followed, inside the row group, by a segment holding needed rows,
# so an over-skip of even one vector changes the answers below
statement ok
CREATE TABLE t_zone(g BIGINT USING COMPRESSION 'uncompressed', s VARCHAR USING COMPRESSION 'dict_fsst')

statement ok
INSERT INTO t_zone
SELECT i::BIGINT,
       CASE WHEN i < 20480 THEN (CASE WHEN i % 7 = 0 THEN '' ELSE 'm:' || md5((i // 3)::VARCHAR) || substr(md5(('x' || (i // 3))::VARCHAR), 1, 30) END)
            WHEN i < 102400 THEN 'z:' || md5((i // 3)::VARCHAR) || substr(md5(('x' || (i // 3))::VARCHAR), 1, 30)
            ELSE (CASE WHEN i % 5 = 0 THEN 'a:' || lpad(i::VARCHAR, 6, '0') ELSE 'q:' || md5((i // 3)::VARCHAR) || substr(md5(('x' || (i // 3))::VARCHAR), 1, 30) END) END
FROM range(122880) tbl(i)

statement ok
CHECKPOINT

restart

query I
SELECT count(*) > 0 FROM pragma_storage_info('t') WHERE column_name = 's' AND segment_type = 'VARCHAR' AND compression = 'DICT_FSST'
----
true

query I
SELECT count(*) FROM pragma_storage_info('t') WHERE column_name = 's' AND segment_type = 'VARCHAR' AND compression <> 'DICT_FSST'
----
0

query I
SELECT count(*) > 0 FROM pragma_storage_info('t_head') WHERE column_name = 's' AND segment_type = 'VARCHAR' AND compression = 'DICT_FSST'
----
true

# the '' prefix of t_head is one whole-row-group segment
query I
SELECT count(*) FROM pragma_storage_info('t_head') WHERE column_name = 's' AND segment_type = 'VARCHAR' AND row_group_id = 0 AND start = 0 AND count = 122880
----
1

# the DICTIONARY-mode tables are DICT_FSST segments in DICTIONARY mode (read from segment_info, never inferred)
query I
SELECT count(*) > 0 AND bool_and(compression = 'DICT_FSST' AND segment_info LIKE 'DICTIONARY:%') FROM pragma_storage_info('t_dm_allnull') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
true

query I
SELECT count(*) > 0 AND bool_and(compression = 'DICT_FSST' AND segment_info LIKE 'DICTIONARY:%') FROM pragma_storage_info('t_dm_one') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
true

query I
SELECT count(*) > 0 AND bool_and(compression = 'DICT_FSST' AND segment_info LIKE 'DICTIONARY:%') FROM pragma_storage_info('t_dm_alleq') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
true

query I
SELECT count(*) > 0 AND bool_and(compression = 'DICT_FSST' AND segment_info LIKE 'DICTIONARY:%') FROM pragma_storage_info('t_dm_bound') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
true

query I
SELECT count(DISTINCT row_group_id) FROM pragma_storage_info('t_dm_bound') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
3

# t_zone geometry: one row group; g in four uncompressed segments at the declared starts
query I
SELECT count(DISTINCT row_group_id) FROM pragma_storage_info('t_zone')
----
1

query II
SELECT start, count FROM pragma_storage_info('t_zone') WHERE column_name = 'g' AND segment_type = 'BIGINT' AND compression = 'Uncompressed' ORDER BY start
----
0	32767
32767	32767
65534	32767
98301	24579

query I
SELECT count(*) > 0 AND bool_and(compression = 'DICT_FSST') FROM pragma_storage_info('t_zone') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
true

# an s segment with start > 0 wholly inside rows 20480-102399 (statistics minimum >= 'z') is followed in the same row group by a segment whose minimum is below 'c'
query I
SELECT count(*) > 0 FROM (SELECT start, count, stats, lead(stats) OVER (ORDER BY start) AS next_stats FROM pragma_storage_info('t_zone') WHERE column_name = 's' AND segment_type = 'VARCHAR') WHERE start > 0 AND start >= 20480 AND start + count <= 102400 AND regexp_extract(stats, 'Min: ([^,]*),', 1) >= 'z' AND regexp_extract(next_stats, 'Min: ([^,]*),', 1) < 'c'
----
true

# --- s <> '' AND the TopN bound on s, at 8 and 1 threads ---

loop threads 1 3

statement ok
SET threads = CASE WHEN ${threads} = 1 THEN 8 ELSE 1 END

query I
SELECT count(*) FROM (SELECT s FROM t WHERE s <> '' ORDER BY s LIMIT 10)
----
10

# the TopN answer equals the answer without a TopN (min(s, 10) keeps duplicates; EXCEPT ALL in both directions)
query I
SELECT count(*) FROM ((SELECT s FROM t WHERE s <> '' ORDER BY s LIMIT 10) EXCEPT ALL (SELECT unnest(min(s, 10)) FROM t WHERE s <> ''))
----
0

query I
SELECT count(*) FROM ((SELECT unnest(min(s, 10)) FROM t WHERE s <> '') EXCEPT ALL (SELECT s FROM t WHERE s <> '' ORDER BY s LIMIT 10))
----
0

# segments holding only '' are skipped; the answer comes from the later segments
query I
SELECT s FROM t_head WHERE s <> '' ORDER BY s LIMIT 3
----
v122880
v122881
v122882

# NULL words never enter the answer (NULLS LAST) and never break the domain check
query I
SELECT count(*) FROM ((SELECT s FROM t_null WHERE s <> '' ORDER BY s LIMIT 10) EXCEPT ALL (SELECT unnest(min(s, 10)) FROM t_null WHERE s <> ''))
----
0

query I
SELECT count(*) FROM (SELECT s FROM t_null WHERE s <> '' ORDER BY s LIMIT 10) WHERE s IS NULL
----
0

# fewer qualifying rows than the limit: every one of them is returned
query I
SELECT s FROM t_small WHERE s <> '' ORDER BY s LIMIT 10
----
v0
v1
v2
v3
v4
v5
v6
v7
v8

query I
SELECT count(*) FROM (SELECT s FROM t WHERE s <> '' ORDER BY s LIMIT 0)
----
0

query I
SELECT s FROM t_head WHERE s <> '' ORDER BY s LIMIT 5 OFFSET 5
----
v122885
v122886
v122887
v122888
v122889

query I
SELECT count(*) FROM ((SELECT s FROM t WHERE s <> '' ORDER BY s LIMIT 5000) EXCEPT ALL (SELECT unnest(min(s, 5000)) FROM t WHERE s <> ''))
----
0

# DESC bound, NULLS FIRST (the OR shape) and a multi-key bound take the row path with unchanged answers
query I
SELECT s FROM t_head WHERE s <> '' ORDER BY s DESC LIMIT 3
----
v249999
v249998
v249997

query I
SELECT count(*) FROM (SELECT s FROM t_null ORDER BY s NULLS FIRST LIMIT 10) WHERE s IS NULL
----
10

query I
SELECT count(*) FROM ((SELECT s, i FROM t WHERE s <> '' ORDER BY s, i LIMIT 10) EXCEPT ALL (SELECT s, i FROM (SELECT s, i, row_number() OVER (ORDER BY s, i) AS rn FROM t WHERE s <> '') WHERE rn <= 10))
----
0

# a second filter column and the bound without s <> ''
query I
SELECT count(*) FROM ((SELECT s FROM t WHERE s <> '' AND k = 7 ORDER BY s LIMIT 10) EXCEPT ALL (SELECT unnest(min(s, 10)) FROM t WHERE s <> '' AND k = 7))
----
0

query I
SELECT count(*) FROM (SELECT s FROM t_head ORDER BY s LIMIT 10) WHERE s = ''
----
10

# a static conjunction on the same column is checked on the dictionary too; the expression form takes the row path
query I
SELECT (SELECT count(*) FROM t WHERE s <> '' AND s < 'v000100') = (SELECT count(*) FROM (SELECT s FROM t) WHERE length(s) > 0 AND s < 'v000100')
----
true

