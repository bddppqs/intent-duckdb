# name: test/sql/storage/compression/dict_fsst/straddle_verdict_filter.test
# description: A vector that crosses DICT_FSST segment boundaries (two or more pieces) takes its codes' cached verdicts for a canonical contains / NOT contains / LIKE filter instead of evaluating each row, and a segment's slot is completed at its first sparse or straddling visit; whole vectors, sparse selections after a filter on another column, NULL and '' rows, the empty needle, a conjunction on one column (not canonical), deleted and updated rows, a LIKE / NOT LIKE / <> '' group by; each answer equals the same query with its filter written as strpos (never canonical, evaluated row by row), at threads 1 and 8, three runs each so later runs read the verdicts earlier runs published
# group: [dict_fsst]

require vector_size 2048

load {TEST_DIR}/straddle_verdict_filter.db readwrite v1.5.0

statement ok
PRAGMA force_compression='dict_fsst'

statement ok
CREATE TABLE t_q AS SELECT i::BIGINT AS i, (i % 2048)::INTEGER AS k, CASE WHEN i % 97 = 0 THEN NULL WHEN i % 89 = 0 THEN '' ELSE 'https://example.com/' || CASE WHEN (i // 3) % 13 = 0 THEN 'Gopher/' ELSE 'site/' END || md5((i // 3)::VARCHAR) || repeat('x', ((i // 3) % 200)::INTEGER) || CASE WHEN (i // 3) % 11 = 0 THEN '/.gopher./' ELSE '/page' END END AS s, CASE WHEN i % 5 = 0 THEN '' ELSE 'q' || ((i // 7) % 1000)::VARCHAR END AS p FROM range(400000) tbl(i)

# long high-entropy strings, one per row: segments of a few hundred rows, so a vector reads three or more pieces
statement ok
CREATE TABLE t_long AS SELECT i::BIGINT AS i, (i % 2048)::INTEGER AS k, CASE WHEN i % 53 = 0 THEN NULL ELSE CASE WHEN i % 9 = 0 THEN 'Gopher-' ELSE 'site-' END || md5((i + 0)::VARCHAR) || md5((i + 1)::VARCHAR) || md5((i + 2)::VARCHAR) || md5((i + 3)::VARCHAR) || md5((i + 4)::VARCHAR) || md5((i + 5)::VARCHAR) || md5((i + 6)::VARCHAR) || md5((i + 7)::VARCHAR) || md5((i + 8)::VARCHAR) || md5((i + 9)::VARCHAR) || md5((i + 10)::VARCHAR) || md5((i + 11)::VARCHAR) || md5((i + 12)::VARCHAR) || md5((i + 13)::VARCHAR) || md5((i + 14)::VARCHAR) || md5((i + 15)::VARCHAR) || md5((i + 16)::VARCHAR) || md5((i + 17)::VARCHAR) || md5((i + 18)::VARCHAR) || md5((i + 19)::VARCHAR) END AS s FROM range(40000) tbl(i)

statement ok
CHECKPOINT

restart

# s is DICT_FSST mode with many segment boundaries inside vectors
query I
SELECT count(*) FILTER (WHERE start % 2048 <> 0) >= 15 AND bool_and(compression = 'DICT_FSST') FROM pragma_storage_info('t_q') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
true

# t_long's segments are shorter than a vector (DICT_FSST mode)
query I
SELECT count(*) FILTER (WHERE count < 2048) >= 40 AND count(*) FILTER (WHERE segment_info LIKE 'DICT_FSST:%') >= 40 AND bool_and(compression = 'DICT_FSST') FROM pragma_storage_info('t_long') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
true

query I
SELECT count(*) FILTER (WHERE segment_info LIKE 'DICT_FSST:%') >= 15 FROM pragma_storage_info('t_q') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
true

loop r 0 6

statement ok
SET threads = CASE WHEN ${r} < 3 THEN 1 ELSE 8 END

# contains on whole vectors
query I
SELECT (SELECT count(*) || '|' || count(s) || '|' || coalesce(min(s), 'NULL') || '|' || coalesce(max(s), 'NULL') || '|' || coalesce(sum(i), 0) FROM t_q WHERE contains(s, 'Gopher')) = (SELECT count(*) || '|' || count(s) || '|' || coalesce(min(s), 'NULL') || '|' || coalesce(max(s), 'NULL') || '|' || coalesce(sum(i), 0) FROM t_q WHERE strpos(s, 'Gopher') > 0)
----
true

# NOT contains on whole vectors (NULL rows fail both forms, '' rows pass both)
query I
SELECT (SELECT count(*) || '|' || count(s) || '|' || coalesce(min(s), 'NULL') || '|' || coalesce(max(s), 'NULL') || '|' || coalesce(sum(i), 0) FROM t_q WHERE NOT contains(s, '.gopher.')) = (SELECT count(*) || '|' || count(s) || '|' || coalesce(min(s), 'NULL') || '|' || coalesce(max(s), 'NULL') || '|' || coalesce(sum(i), 0) FROM t_q WHERE strpos(s, '.gopher.') = 0)
----
true

# LIKE (rewritten to contains) after a constant filter on another column
query I
SELECT (SELECT count(*) || '|' || coalesce(min(s), 'NULL') || '|' || coalesce(sum(i), 0) FROM t_q WHERE s LIKE '%Gopher%' AND p <> '') = (SELECT count(*) || '|' || coalesce(min(s), 'NULL') || '|' || coalesce(sum(i), 0) FROM t_q WHERE strpos(s, 'Gopher') > 0 AND p <> '')
----
true

# sparse selections: 1, 300, 1024, 1025 and 2047 rows of each vector reach the straddle filter
query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 1 AND contains(s, 'Gopher')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 1 AND strpos(s, 'Gopher') > 0)
----
true

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 300 AND contains(s, 'Gopher')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 300 AND strpos(s, 'Gopher') > 0)
----
true

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 1024 AND NOT contains(s, '.gopher.')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 1024 AND strpos(s, '.gopher.') = 0)
----
true

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 1025 AND contains(s, 'Gopher')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 1025 AND strpos(s, 'Gopher') > 0)
----
true

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 2047 AND NOT contains(s, '.gopher.')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 2047 AND strpos(s, '.gopher.') = 0)
----
true

# the empty needle: every non-NULL row passes
query I
SELECT (SELECT count(*) FROM t_q WHERE contains(s, '')) = (SELECT count(s) FROM t_q)
----
true

# vectors of three or more pieces
query I
SELECT (SELECT count(*) || '|' || coalesce(min(s), 'NULL') || '|' || coalesce(sum(i), 0) FROM t_long WHERE contains(s, 'Gopher')) = (SELECT count(*) || '|' || coalesce(min(s), 'NULL') || '|' || coalesce(sum(i), 0) FROM t_long WHERE strpos(s, 'Gopher') > 0)
----
true

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_long WHERE k < 900 AND NOT contains(s, 'Gopher')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_long WHERE k < 900 AND strpos(s, 'Gopher') = 0)
----
true

# two filters on one column (a conjunction, not canonical: the row-by-row path)
query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE contains(s, 'Gopher') AND NOT contains(s, '.gopher.')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE strpos(s, 'Gopher') > 0 AND strpos(s, '.gopher.') = 0)
----
true

# LIKE, NOT LIKE on another column's shape, <> '' and a grouped aggregate with MIN and COUNT(DISTINCT)
query I
SELECT (SELECT string_agg(p || ':' || c || ':' || m || ':' || d, ',' ORDER BY p) FROM (SELECT p, count(*) AS c, min(s) AS m, count(DISTINCT i // 3) AS d FROM t_q WHERE s LIKE '%Gopher%' AND s NOT LIKE '%.gopher.%' AND p <> '' GROUP BY p)) = (SELECT string_agg(p || ':' || c || ':' || m || ':' || d, ',' ORDER BY p) FROM (SELECT p, count(*) AS c, min(s) AS m, count(DISTINCT i // 3) AS d FROM t_q WHERE strpos(s, 'Gopher') > 0 AND strpos(s, '.gopher.') = 0 AND p <> '' GROUP BY p))
----
true

query I
SELECT (SELECT string_agg(p || ':' || c || ':' || m, ',' ORDER BY c DESC, p) FROM (SELECT p, count(*) AS c, min(s) AS m FROM t_q WHERE s LIKE '%Gopher%' AND p <> '' GROUP BY p ORDER BY c DESC, p LIMIT 10)) = (SELECT string_agg(p || ':' || c || ':' || m, ',' ORDER BY c DESC, p) FROM (SELECT p, count(*) AS c, min(s) AS m FROM t_q WHERE strpos(s, 'Gopher') > 0 AND p <> '' GROUP BY p ORDER BY c DESC, p LIMIT 10))
----
true

endloop

# deleted rows: the scan's selection starts set
statement ok
DELETE FROM t_q WHERE i % 3 = 1

loop r 0 4

statement ok
SET threads = CASE WHEN ${r} < 2 THEN 1 ELSE 8 END

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE contains(s, 'Gopher')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE strpos(s, 'Gopher') > 0)
----
true

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 700 AND NOT contains(s, '.gopher.')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 700 AND strpos(s, '.gopher.') = 0)
----
true

endloop

# updated rows: the column has updates (the flat scan merges them; the verdict path declines)
statement ok
UPDATE t_q SET s = CASE WHEN i % 2 = 0 THEN 'updated Gopher row' ELSE 'updated plain row' END WHERE i % 1000 = 0

loop r 0 4

statement ok
SET threads = CASE WHEN ${r} < 2 THEN 1 ELSE 8 END

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE contains(s, 'Gopher')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE strpos(s, 'Gopher') > 0)
----
true

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 1500 AND NOT contains(s, 'plain')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 1500 AND strpos(s, 'plain') = 0)
----
true

endloop

# after a checkpoint and a restart the rewritten segments are scanned from disk again
statement ok
CHECKPOINT

restart

loop r 0 4

statement ok
SET threads = CASE WHEN ${r} < 2 THEN 1 ELSE 8 END

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE contains(s, 'Gopher')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE strpos(s, 'Gopher') > 0)
----
true

query I
SELECT (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 1025 AND NOT contains(s, '.gopher.')) = (SELECT count(*) || '|' || coalesce(sum(i), 0) FROM t_q WHERE k < 1025 AND strpos(s, '.gopher.') = 0)
----
true

endloop
