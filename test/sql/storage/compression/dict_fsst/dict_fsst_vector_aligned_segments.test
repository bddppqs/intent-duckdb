# name: test/sql/storage/compression/dict_fsst/dict_fsst_vector_aligned_segments.test
# description: A DICT_FSST segment that fills up ends on a vector boundary of its row group; answers unchanged
# group: [dict_fsst]

# the vector-aligned writer (kVectorAlignedDictionarySegments, on by default); a build with the flag off writes segments
# that start inside vectors, dict_fsst_unaligned_writer_geometry.test's geometry
require vector_aligned_dictionary_segments

statement ok
ATTACH '__TEST_DIR__/vector_aligned_segments.db' AS va (STORAGE_VERSION 'v1.5.0')

statement ok
USE va

statement ok
SET force_compression='dict_fsst'

# repeated strings (DICT_FSST mode), unique strings (FSST_ONLY mode) and NULLs, three row groups, the last one partial

statement ok
CREATE TABLE t AS SELECT i, CASE WHEN i % 97 = 0 THEN NULL ELSE 'https://www.example-' || (hash(i // 3) % 7001)::VARCHAR || '.org/some/path/' || repeat('p', (i % 37)::INT) || '/' || (i % 911)::VARCHAR END AS s, 'unique-value-' || i::VARCHAR || '-' || repeat('u', (i % 29)::INT) AS u FROM range(300000) r(i)

statement ok
CHECKPOINT

# each column fills several segments per row group

query II
SELECT count(*) FILTER (WHERE column_name = 's') > 6, count(*) FILTER (WHERE column_name = 'u') > 6 FROM pragma_storage_info('t') WHERE segment_type = 'VARCHAR' AND start > 0
----
true	true

# no segment starts inside a vector

query I
SELECT count(*) FROM pragma_storage_info('t') WHERE segment_type = 'VARCHAR' AND start % 2048 <> 0
----
0

query I
SELECT count(*) FROM t WHERE s IS DISTINCT FROM (CASE WHEN i % 97 = 0 THEN NULL ELSE 'https://www.example-' || (hash(i // 3) % 7001)::VARCHAR || '.org/some/path/' || repeat('p', (i % 37)::INT) || '/' || (i % 911)::VARCHAR END)
----
0

query I
SELECT count(*) FROM t WHERE u <> 'unique-value-' || i::VARCHAR || '-' || repeat('u', (i % 29)::INT)
----
0

query II
SELECT count(s), count(DISTINCT u) FROM t
----
296907	300000
