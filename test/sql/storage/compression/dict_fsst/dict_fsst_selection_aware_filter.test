https://example.com/search/0c383e8deecbd58d5cbdfd324132b91f/page	3

# COUNT(DISTINCT) on the filtered column after a sparse selection
query II
SELECT count(DISTINCT s), count(*) FROM t_sel WHERE k < 300 AND contains(s, 'ab')
----
2079	6066

# a hash join on the filtered column after a sparse selection
query II
SELECT count(*), min(a.s) FROM t_sel a JOIN t_two b ON a.s = b.b WHERE a.k < 5 AND contains(a.s, 'a')
----
1780	https://example.com/search/01cc1da1d5e00d6c7fb60943b4b03f68/page

