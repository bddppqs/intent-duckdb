# name: test/sql/storage/compression/dict_fsst/dict_fsst_selection_aware_filter.test
# description: Selection-aware DICT_FSST filter evaluation: a selective constant filter on an INTEGER column followed by contains / NOT contains / LIKE with _ / prefix / = / IS NULL on DICT_FSST-, DICTIONARY- and FSST_ONLY-mode string columns, with selections of 0, 1, a few, 1024, 1025, 2047 and every row per vector, NULLs at referenced and unreferenced codes, an all-NULL segment, tables shorter than a vector, exactly 2048 and 2049 rows, whole-domain readers after a sparse selection; the answers are the plain engine answers at threads 1 and 8
# group: [dict_fsst]

# The straddling segments this test writes need the unaligned DICT_FSST writer, so it runs only in a build with
# kVectorAlignedDictionarySegments off (the default writer ends every segment on a vector boundary). In the default
# build, dict_fsst_straddled_segments_read.test reaches the same scan paths on a checked-in straddled file.
require unaligned_dictionary_segments

require vector_size 2048

load {TEST_DIR}/dict_fsst_selection_aware_filter.db readwrite v1.5.0

statement ok
PRAGMA force_compression='dict_fsst'

statement ok
CREATE TABLE t_sel AS SELECT i::BIGINT AS i, (i % 2048)::INTEGER AS k, CASE WHEN i % 97 = 0 THEN NULL WHEN i % 89 = 0 THEN '' ELSE 'https://example.com/search/' || md5((i // 3)::VARCHAR) || '/page' END AS s, CASE WHEN i % 101 = 0 THEN NULL ELSE 'd' || lpad((i % 20)::VARCHAR, 2, '0') END AS d, 'u' || i::VARCHAR || repeat('z', 30) || i::VARCHAR AS f FROM range(368640) tbl(i)

statement ok
CREATE TABLE t_two AS SELECT i::BIGINT AS i, CASE WHEN i % 500 = 0 THEN 'needle-' || (i // 500)::VARCHAR ELSE 'https://example.com/search/' || md5((i // 5)::VARCHAR) || '/page' END AS a, CASE WHEN i % 91 = 0 THEN NULL ELSE 'https://example.com/search/' || md5((i // 7)::VARCHAR) || '/page' END AS b FROM range(245760) tbl(i)

statement ok
CREATE TABLE t_short AS SELECT i::BIGINT AS i, (i % 2048)::INTEGER AS k, CASE WHEN i % 7 = 0 THEN '' ELSE 'v' || lpad(((i * 31) % 1000)::VARCHAR, 4, '0') END AS s FROM range(100) tbl(i)

statement ok
CREATE TABLE t_2048 AS SELECT i::BIGINT AS i, (i % 2048)::INTEGER AS k, CASE WHEN i % 97 = 0 THEN NULL ELSE 'https://example.com/search/' || md5((i // 3)::VARCHAR) || '/page' END AS s FROM range(2048) tbl(i)

statement ok
CREATE TABLE t_2049 AS SELECT i::BIGINT AS i, (i % 2048)::INTEGER AS k, CASE WHEN i % 97 = 0 THEN NULL ELSE 'https://example.com/search/' || md5((i // 3)::VARCHAR) || '/page' END AS s FROM range(2049) tbl(i)

statement ok
CREATE TABLE t_allnull AS SELECT i::BIGINT AS i, (i % 2048)::INTEGER AS k, CASE WHEN i < 250000 THEN NULL ELSE 'v' || lpad(i::VARCHAR, 6, '0') END AS s FROM range(300000) tbl(i)

statement ok
CHECKPOINT

restart

# the modes read from segment_info (never inferred); s carries a segment boundary inside a vector

query I
SELECT count(*) > 0 AND bool_and(compression = 'DICT_FSST' AND segment_info LIKE 'DICT_FSST:%') FROM pragma_storage_info('t_sel') WHERE column_name = 's' AND segment_type = 'VARCHAR'
----
true

query I
SELECT count(*) > 0 AND bool_and(compression = 'DICT_FSST' AND segment_info LIKE 'DICTIONARY:%') FROM pragma_storage_info('t_sel') WHERE column_name = 'd' AND segment_type = 'VARCHAR'
----
true

query I
SELECT bool_or(compression = 'DICT_FSST' AND segment_info LIKE 'FSST_ONLY:%') FROM pragma_storage_info('t_sel') WHERE column_name = 'f' AND segment_type = 'VARCHAR'
----
true

query I
SELECT count(*) > 0 FROM pragma_storage_info('t_sel') WHERE column_name = 's' AND segment_type = 'VARCHAR' AND start > 0 AND start % 2048 <> 0
----
true

loop t 0 2

statement ok
SET threads = CASE WHEN ${t} = 0 THEN 1 ELSE 8 END

# no row of any vector; contains
query IIII
SELECT count(*), count(s), min(s), max(s) FROM t_sel WHERE k < 0 AND contains(s, 'abc')
----
0	0	NULL	NULL

# no row of any vector; NOT contains
query IIII
SELECT count(*), count(s), min(s), max(s) FROM t_sel WHERE k < 0 AND NOT contains(s, 'abc')
----
0	0	NULL	NULL

# no row of any vector; LIKE with _ (not rewritten)
query IIII
SELECT count(*), count(s), min(s), max(s) FROM t_sel WHERE k < 0 AND s LIKE '%ab_c%'
----
0	0	NULL	NULL

# no row of any vector; prefix
query IIII
SELECT count(*), count(s), min(s), max(s) FROM t_sel WHERE k < 0 AND s LIKE 'https://example.com/search/a%'
----
0	0	NULL	NULL

# no row of any vector; equality
query IIII
SELECT count(*), count(s), min(s), max(s) FROM t_sel WHERE k < 0 AND s = 'https://example.com/search/' || md5('333') || '/page'
----
0	0	NULL	NULL

# no row of any vector; IS NULL
query IIII
SELECT count(*), count(s), min(s), max(s) FROM t_sel WHERE k < 0 AND s IS NULL
----
0	0	NULL	NULL

# no row of any vector; IS NOT NULL
query IIII
SELECT count(*), count(s), min(s), max(s) FROM t_sel WHERE k < 0 AND s IS NOT NULL
----
0	0	NULL	NULL

# no row of any vector; contains on the DICTIONARY-mode column
query IIII
SELECT count(*), count(d), min(d), max(d) FROM t_sel WHERE k < 0 AND contains(d, '1')
----
0	0	NULL	NULL

# no row of any vector; contains on the FSST_ONLY column
query II
SELECT count(*), min(f) FROM t_sel WHERE k < 0 AND contains(f, 'zz1')
----
0	NULL

