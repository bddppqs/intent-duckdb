# a GROUP BY on the filtered column after a sparse selection (the flat survivor vector is hashed whole)
query TI
SELECT s, count(*) AS c FROM t_sel WHERE k < 5 AND contains(s, 'a') GROUP BY s ORDER BY c DESC, s LIMIT 5
----
https://example.com/search/051928341be67dcba03f0e04104d9047/page	3
https://example.com/search/061c8b4347d970f009ea500be31c577d/page	3
