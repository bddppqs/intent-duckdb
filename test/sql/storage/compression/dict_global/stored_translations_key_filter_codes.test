query I
SELECT count(*) FROM ((SELECT e, count(*), sum(i) FROM rs WHERE e <> '' AND e IS NOT NULL GROUP BY e) EXCEPT ALL (SELECT e, count(*), sum(i) FROM s WHERE e <> '' AND e IS NOT NULL GROUP BY e))
----
