# a delete: the deleted rows leave the result through the deletion mask over the positional codes vector, before and
# after the checkpoint
statement ok
DELETE FROM t WHERE i % 13 = 5 OR (i >= 1000000 AND i < 1004096)

statement ok
DELETE FROM r WHERE i % 13 = 5 OR (i >= 1000000 AND i < 1004096)

query II
EXPLAIN SELECT b, count(*), sum(i) FROM t WHERE b <> '' GROUP BY b
----
physical_plan	<REGEX>:.*Codes Only.*

