restart

endloop

# a statement prepared over stored translations, executed after a checkpoint that rebuilt them (new data): re-bound
# before it executes, never an internal error
statement ok
CREATE TABLE p AS SELECT 'pv-' || ((i // 3) % 100003) || '-0123456789abcdef' AS s FROM range(1048576) r(i)

statement ok
CHECKPOINT

statement ok
PREPARE top_p AS SELECT s, count(*) AS n FROM p GROUP BY s ORDER BY n DESC, s LIMIT 2

statement ok
PREPARE distinct_p AS SELECT count(DISTINCT s) FROM p

query II
EXPLAIN SELECT s, count(*) AS n FROM p GROUP BY s ORDER BY n DESC, s LIMIT 2
----
physical_plan	<REGEX>:.*Code Keys: s \(stored\).*

query II
EXECUTE top_p
----
pv-0-0123456789abcdef	12
pv-1-0123456789abcdef	12

query I
EXECUTE distinct_p
----
100003

# a checkpoint that carries the translations unchanged
statement ok
CHECKPOINT

query II
EXECUTE top_p
----
pv-0-0123456789abcdef	12
pv-1-0123456789abcdef	12

statement ok
INSERT INTO p SELECT 'pv-new-' || (i % 3) || '-0123456789abcdef' FROM range(120) r(i)

# before the checkpoint the appended rows are transient: the statement takes the standard path
query II
EXECUTE top_p
----
pv-new-0-0123456789abcdef	40
pv-new-1-0123456789abcdef	40

statement ok
CHECKPOINT

query II
EXECUTE top_p
----
pv-new-0-0123456789abcdef	40
pv-new-1-0123456789abcdef	40

query I
EXECUTE distinct_p
----
100006

query I
EXECUTE distinct_p
----
100006

# prepared before a checkpoint, executed after it twice in a row, and after a restart re-prepared
statement ok
PREPARE top_p2 AS SELECT s, count(*) AS n FROM p WHERE s <> '' GROUP BY s ORDER BY n DESC, s LIMIT 1

statement ok
INSERT INTO p SELECT 'pv-newer-0123456789abcdef' FROM range(77) r(i)

statement ok
CHECKPOINT

query II
EXECUTE top_p2
----
pv-newer-0123456789abcdef	77

query II
EXECUTE top_p2
----
pv-newer-0123456789abcdef	77

statement ok
DEALLOCATE top_p

statement ok
DEALLOCATE top_p2

statement ok
DEALLOCATE distinct_p

statement ok
DROP TABLE p

statement ok
CHECKPOINT

# an append not yet checkpointed: the codes-only path is refused (local and transient rows hold strings)
statement ok
INSERT INTO t SELECT i, 'appended-' || (i % 7) || '-xxxxxxxxxxxx', 'wval-5-0123456789', 'appended', 'appended-d' FROM range(6291456, 6291456 + 5000) r(i)

query II
SELECT a, count(*) AS n FROM t GROUP BY a ORDER BY n DESC LIMIT 3
----
group-999-xxxxxxxxxxxx	1999
group-998-xxxxxxxxxxxx	1997
group-997-xxxxxxxxxxxx	1995

query I
SELECT count(*) FROM t WHERE b = 'wval-5-0123456789'
----
5030

query I
SELECT count(DISTINCT a) FROM t
----
201010

# the next checkpoint builds the translations again over the new segments
statement ok
CHECKPOINT

restart

query II
SELECT a, count(*) AS n FROM t GROUP BY a ORDER BY n DESC LIMIT 3
----
group-999-xxxxxxxxxxxx	1999
group-998-xxxxxxxxxxxx	1997
group-997-xxxxxxxxxxxx	1995

query I
SELECT count(DISTINCT a) FROM t
----
201010

# an update of the column: its codes are read the standard way until a checkpoint rewrites it
statement ok
UPDATE t SET b = 'updated-0123456789' WHERE i % 100000 = 1

query I
SELECT count(*) FROM (SELECT b FROM t WHERE b <> '' GROUP BY b) s WHERE b = 'updated-0123456789'
----
1

query I
SELECT count(DISTINCT b) FROM t
----
200005

statement ok
CHECKPOINT

restart

query I
SELECT count(DISTINCT b) FROM t
----
200005

# an alter that renumbers the storage indexes: no stored translation is read until the next checkpoint
statement ok
ALTER TABLE t DROP COLUMN i

query II
SELECT a, count(*) AS n FROM t GROUP BY a ORDER BY n DESC LIMIT 2
----
group-999-xxxxxxxxxxxx	1999
group-998-xxxxxxxxxxxx	1997

statement ok
CHECKPOINT

restart

query II
SELECT a, count(*) AS n FROM t GROUP BY a ORDER BY n DESC LIMIT 2
----
group-999-xxxxxxxxxxxx	1999
group-998-xxxxxxxxxxxx	1997

query I
SELECT count(DISTINCT b) FROM t
----
200005

# a dropped table frees its code blocks and translation blocks (debug_verify_blocks checks the counts)
statement ok
DROP TABLE t

statement ok
CHECKPOINT

restart

statement ok
CREATE TABLE t2 AS SELECT 'again-' || ((i // 3) % 100003) || '-0123456789' AS a FROM range(1048576) r(i)

statement ok
CHECKPOINT

query I
SELECT count(DISTINCT a) FROM t2
----
100003
