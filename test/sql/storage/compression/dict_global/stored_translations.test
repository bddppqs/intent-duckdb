query I
SELECT count(*) FROM ((SELECT s, count(*) FROM small GROUP BY s) EXCEPT ALL (SELECT 'value-' || (i % 1000) || '-0123456789', count(*) FROM range(1048576) r(i) GROUP BY 1))
----
