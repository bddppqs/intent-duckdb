# name: test/sql/function/string/regex_replace_slice.test
# description: regexp_replace with a one-group rewrite of a match spanning the input, and regexp_extract of one group, on uncompressed and dictionary-compressed strings with 3 000 and 25 000 distinct values: other rewrites, the 'g' option, short and long results, NULL and empty strings, per-row patterns, and results read after a scan of several vectors ends
# group: [string]

load __TEST_DIR__/regex_replace_slice.db readwrite v1.3.0

statement ok
PRAGMA force_compression='uncompressed'

# key k: NULL (k = 0), the empty string (k = 1), a word (k % 10 = 7), otherwise a web address
statement ok
CREATE TABLE p3 AS SELECT i, CASE WHEN i % 3000 = 0 THEN NULL WHEN i % 3000 = 1 THEN '' WHEN i % 3000 % 10 = 7 THEN 'word' || (i % 3000)::VARCHAR ELSE 'https://h' || (i % 3000 % 40)::VARCHAR || '.example.com/p' || (i % 3000)::VARCHAR || '/' || repeat('x', (i % 3000 % 17)::INTEGER) END AS s FROM range(30000) t(i)

statement ok
CREATE TABLE p25 AS SELECT i, CASE WHEN i % 25000 = 0 THEN NULL WHEN i % 25000 = 1 THEN '' WHEN i % 25000 % 10 = 7 THEN 'word' || (i % 25000)::VARCHAR ELSE 'https://h' || (i % 25000 % 40)::VARCHAR || '.example.com/p' || (i % 25000)::VARCHAR || '/' || repeat('x', (i % 25000 % 17)::INTEGER) END AS s FROM range(50000) t(i)

statement ok
CHECKPOINT

statement ok
PRAGMA force_compression='dict_fsst'

statement ok
CREATE TABLE d3 AS SELECT * FROM p3

statement ok
CREATE TABLE d25 AS SELECT * FROM p25

statement ok
CHECKPOINT

restart

query II
SELECT (SELECT count(*) > 0 FROM pragma_storage_info('d3') WHERE column_name = 's' AND segment_type = 'VARCHAR' AND compression = 'DICT_FSST'), (SELECT count(*) > 0 FROM pragma_storage_info('d25') WHERE column_name = 's' AND segment_type = 'VARCHAR' AND compression = 'DICT_FSST')
----
true	true

# whole-input matches with one group (results longer and shorter than 12 bytes, the whole input), a match with a
# prefix and a suffix, a match with a suffix, two groups, a backslash rewrite, the 'g' option, and regexp_extract
query ITTTTTTTTTT nosort slice_3k
SELECT i,
	regexp_replace(s, '^https://([^/]+)/.*$', '\1'),
	regexp_replace(s, '^https://[^/]+/(p[0-9]+)/x*$', '\1'),
	regexp_replace(s, '^(.*)$', '\1'),
	regexp_replace(s, '/(p[0-9]+)/', '\1'),
	regexp_replace(s, '^https://([^/]+)', '\1'),
	regexp_replace(s, '^https://([^/]+)/(.*)$', '\2@\1'),
	regexp_replace(s, '^https://([^/]+)/.*$', '\\'),
	regexp_replace(s, '^https://([^/]+)/.*$', '\1', 'g'),
	regexp_extract(s, '^https://([^/]+)/.*$', 1),
	regexp_extract(s, '/(p[0-9]+)/', 1)
FROM p3 ORDER BY i
----

query ITTTTTTTTTT nosort slice_3k
