# a pattern per row
query IT nosort per_row_3k
SELECT i, regexp_replace(s, CASE WHEN i % 2 = 0 THEN '^https://([^/]+)/.*$' ELSE '^(.*)$' END, '\1') FROM p3 ORDER BY i
----

query IT nosort per_row_3k
SELECT i, regexp_replace(s, CASE WHEN i % 2 = 0 THEN '^https://([^/]+)/.*$' ELSE '^(.*)$' END, '\1') FROM d3 ORDER BY i
----

# where the whole-input pattern matches, the one-group rewrite and regexp_extract of that group agree: every key but
# 0, 1 and those with k % 10 = 7 is a web address (2 698 of each 3 000 keys, 22 498 of each 25 000)
query II
SELECT count(*) FILTER (WHERE m), count(*) FILTER (WHERE m AND r IS DISTINCT FROM e) FROM (SELECT regexp_full_match(s, '^https://([^/]+)/.*$') AS m, regexp_replace(s, '^https://([^/]+)/.*$', '\1') AS r, regexp_extract(s, '^https://([^/]+)/.*$', 1) AS e FROM d3)
----
26980	0

query II
SELECT count(*) FILTER (WHERE m), count(*) FILTER (WHERE m AND r IS DISTINCT FROM e) FROM (SELECT regexp_full_match(s, '^https://[^/]+/(p[0-9]+)/x*$') AS m, regexp_replace(s, '^https://[^/]+/(p[0-9]+)/x*$', '\1') AS r, regexp_extract(s, '^https://[^/]+/(p[0-9]+)/x*$', 1) AS e FROM d3)
----
26980	0

query II
SELECT count(*) FILTER (WHERE m), count(*) FILTER (WHERE m AND r IS DISTINCT FROM e) FROM (SELECT regexp_full_match(s, '^https://([^/]+)/.*$') AS m, regexp_replace(s, '^https://([^/]+)/.*$', '\1') AS r, regexp_extract(s, '^https://([^/]+)/.*$', 1) AS e FROM d25)
----
44996	0

query II
SELECT count(*) FILTER (WHERE m), count(*) FILTER (WHERE m AND r IS DISTINCT FROM e) FROM (SELECT regexp_full_match(s, '^https://([^/]+)/.*$') AS m, regexp_replace(s, '^https://([^/]+)/.*$', '\1') AS r, regexp_extract(s, '^https://([^/]+)/.*$', 1) AS e FROM p3)
----
26980	0

# results stored by a scan of several vectors and read after it ends
statement ok
CREATE TABLE r3 AS SELECT i, regexp_replace(s, '^https://([^/]+)/.*$', '\1') AS host, regexp_replace(s, '^https://[^/]+/(p[0-9]+)/x*$', '\1') AS path, regexp_extract(s, '^https://([^/]+)/.*$', 1) AS extracted, regexp_replace(s, '^https://([^/]+)/.*$', '\\') AS backslash FROM d3

statement ok
CREATE TABLE r25 AS SELECT i, regexp_replace(s, '^https://([^/]+)/.*$', '\1') AS host, regexp_replace(s, '^https://[^/]+/(p[0-9]+)/x*$', '\1') AS path, regexp_extract(s, '^https://([^/]+)/.*$', 1) AS extracted, regexp_replace(s, '^https://([^/]+)/.*$', '\\') AS backslash FROM d25

query IIII
SELECT count(*), count(*) FILTER (WHERE host IS DISTINCT FROM regexp_replace(p3.s, '^https://([^/]+)/.*$', '\1')), count(*) FILTER (WHERE path IS DISTINCT FROM regexp_replace(p3.s, '^https://[^/]+/(p[0-9]+)/x*$', '\1')), count(*) FILTER (WHERE extracted IS DISTINCT FROM regexp_extract(p3.s, '^https://([^/]+)/.*$', 1)) FROM r3 JOIN p3 USING (i)
----
30000	0	0	0

query IIII
SELECT count(*), count(*) FILTER (WHERE host IS DISTINCT FROM regexp_replace(p25.s, '^https://([^/]+)/.*$', '\1')), count(*) FILTER (WHERE path IS DISTINCT FROM regexp_replace(p25.s, '^https://[^/]+/(p[0-9]+)/x*$', '\1')), count(*) FILTER (WHERE extracted IS DISTINCT FROM regexp_extract(p25.s, '^https://([^/]+)/.*$', 1)) FROM r25 JOIN p25 USING (i)
----
50000	0	0	0

query ITTTT
SELECT i, host, path, extracted, backslash FROM r3 WHERE i IN (0, 1, 2, 5, 16, 17, 1234, 3005) ORDER BY i
----
0	NULL	NULL	NULL	NULL
1	(empty)	(empty)	(empty)	(empty)
2	h2.example.com	p2	h2.example.com	\
5	h5.example.com	p5	h5.example.com	\
16	h16.example.com	p16	h16.example.com	\
17	word17	word17	(empty)	word17
1234	h34.example.com	p1234	h34.example.com	\
3005	h5.example.com	p5	h5.example.com	\

