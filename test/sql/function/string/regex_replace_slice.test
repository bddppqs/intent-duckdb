	regexp_replace(s, '/(p[0-9]+)/', '\1'),
	regexp_replace(s, '^https://([^/]+)', '\1'),
	regexp_replace(s, '^https://([^/]+)/(.*)$', '\2@\1'),
	regexp_replace(s, '^https://([^/]+)/.*$', '\\'),
	regexp_replace(s, '^https://([^/]+)/.*$', '\1', 'g'),
	regexp_extract(s, '^https://([^/]+)/.*$', 1),
	regexp_extract(s, '/(p[0-9]+)/', 1)
FROM d3 ORDER BY i
