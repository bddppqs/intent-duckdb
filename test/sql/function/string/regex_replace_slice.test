# literals
query TTTT
SELECT regexp_replace('https://example.com/a/b', '^https://([^/]+)/.*$', '\1'), regexp_replace('https://example.com/a/b', '^https://[^/]+/(a)/b$', '\1'), regexp_replace('https://example.com/a/b', '/(a)/', '\1'), regexp_extract('https://example.com/a/b', '^https://([^/]+)/(.*)$', 2)
----
example.com	a	https://example.comab	a/b
