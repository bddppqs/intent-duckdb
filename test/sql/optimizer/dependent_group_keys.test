# name: test/sql/optimizer/dependent_group_keys.test
# description: a group key x + k, k + x or x - k (k a constant, x a retained integer group key of the same type) is removed
# from the aggregate and rebuilt above it when the statistics of x prove the arithmetic cannot overflow; every signed and
# unsigned integer width up to 64 bits; the answers equal those with the pass disabled
# group: [optimizer]

statement ok
PRAGMA explain_output = 'optimized_only'

# each x spans more than its type's next smaller width, so no key is compressed before the pass reads it
statement ok
CREATE TABLE t_tinyint AS SELECT CASE WHEN i = 100 THEN NULL ELSE (0 + 10 * (i % 10))::TINYINT END AS x, i AS y FROM range(101) r(i)

# TINYINT: the three dependent keys are removed, one group key remains
query II
EXPLAIN SELECT x, x + 1::TINYINT AS p, x - 2::TINYINT AS m, 3::TINYINT + x AS q, count(*) FROM t_tinyint GROUP BY x, p, m, q
----
logical_opt	<REGEX>:.*Groups: x.*

query IIIIII
SELECT count(*), sum(x), sum(p), sum(m), sum(q), sum(c) FROM (SELECT x, x + 1::TINYINT AS p, x - 2::TINYINT AS m, 3::TINYINT + x AS q, count(*) AS c FROM t_tinyint GROUP BY x, p, m, q)
----
11	450	460	430	480	101

statement ok
SET disabled_optimizers = 'duplicate_groups'

query II
EXPLAIN SELECT x, x + 1::TINYINT AS p, x - 2::TINYINT AS m, 3::TINYINT + x AS q, count(*) FROM t_tinyint GROUP BY x, p, m, q
----
logical_opt	<!REGEX>:.*Groups: x.*

query IIIIII
SELECT count(*), sum(x), sum(p), sum(m), sum(q), sum(c) FROM (SELECT x, x + 1::TINYINT AS p, x - 2::TINYINT AS m, 3::TINYINT + x AS q, count(*) AS c FROM t_tinyint GROUP BY x, p, m, q)
----
11	450	460	430	480	101

statement ok
RESET disabled_optimizers

