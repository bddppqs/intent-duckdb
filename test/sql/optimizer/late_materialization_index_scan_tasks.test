# name: test/sql/optimizer/late_materialization_index_scan_tasks.test
# description: The late-materialised row-id fetch (its index scan) at 1, 5, 7, 9, 10 and 50 row ids and threads 1, 2, 3, 8 and 16 - the index scan's task cap and its split of a small fetch into per-task batches - over dict_fsst, rle, bitpacking, hugeint, double, date, timestamp and nullable columns, LIMIT ... OFFSET, SELECT *, user row-id IN lists over RLE columns at run and 16-run block boundaries (the RLE fetch's block skip), a transaction with an uncommitted append that matches (the local-storage phase) and one that deletes result rows; the expected rows are the base path's answers (threads 1)
# group: [optimizer]

require vector_size 2048

load __TEST_DIR__/late_materialization_index_scan_tasks.db readwrite v1.5.0

statement ok
CREATE TABLE t(i BIGINT, o BIGINT, k INTEGER, s VARCHAR USING COMPRESSION 'dict_fsst', u VARCHAR USING COMPRESSION 'dict_fsst', d DATE, ts TIMESTAMP, r SMALLINT USING COMPRESSION 'rle', b BIGINT USING COMPRESSION 'bitpacking', h HUGEINT, f DOUBLE, n VARCHAR)

statement ok
INSERT INTO t SELECT i, (i * 7919) % 300007, (i % 2048)::INTEGER, 's' || (i % 97)::VARCHAR, CASE WHEN i % 4001 = 0 THEN 'needle-' || i::VARCHAR ELSE 'hay-' || md5(i::VARCHAR) END, DATE '2020-01-01' + (i % 1000)::INTEGER, TIMESTAMP '2020-01-01' + to_seconds(i), (i // 5000)::SMALLINT, i // 3, i::HUGEINT * 1000000007, i / 8, CASE WHEN i % 3 = 0 THEN NULL ELSE 'n' || i::VARCHAR END FROM range(300000) tbl(i)

statement ok
CREATE TABLE r(i BIGINT, a SMALLINT USING COMPRESSION 'rle', b INTEGER USING COMPRESSION 'rle', c BIGINT USING COMPRESSION 'rle', d SMALLINT USING COMPRESSION 'rle')

statement ok
INSERT INTO r SELECT i, ((i // 3) % 1000)::SMALLINT, (i // 7)::INTEGER, (i // 1)::BIGINT, (i % 2)::SMALLINT FROM range(300000) tbl(i)

statement ok
CHECKPOINT

restart

foreach thr 1 2 3 8 16

statement ok
SET threads = ${thr}

