BEGIN TRANSACTION

statement ok
INSERT INTO t_rf SELECT 900000 + i, i - 5, 0, 0, 'needle-local-' || i::VARCHAR, 'wl', 'v:' || md5((900000 + i)::VARCHAR), 0, 0 FROM range(5) tbl(i)

# inside a transaction with an uncommitted append (transaction-local row ids)
query IIIIIIIII
SELECT i, o, k, g, u, w, v, n1, n3 FROM t_rf WHERE contains(u, 'needle') ORDER BY o LIMIT 10
