statement ok
RESET late_materialization_max_rows

# a base-table sample of 10 rows, late-materialised: every column a function of i
query II
SELECT count(*), bool_and(o = (i * 7919) % 400000 AND k = i % 2048 AND g = i // 1000 AND v = 'v:' || md5(i::VARCHAR) AND w = 'w' || lpad((i % 50)::VARCHAR, 2, '0') AND n1 = i % 997 AND n3 = i % 100) FROM (SELECT * FROM t_rf USING SAMPLE 10 ROWS)
----
10	true

# a user row-id IN list, two row ids past the table
query III
SELECT i, u, v FROM t_rf WHERE rowid IN (5, 70000, 123456, 399999, 400001, 1000000) ORDER BY i
----
5	https://example.com/m1/c4ca4238a0b923820dcc509a6f75849b	v:e4da3b7fbbce2345d7772b0674a318d5
70000	https://example.com/m1/0ba7bc92fcd57e337ebb9e74308c811f	v:3078a255aee86ecc4ac1eb36b69af2f0
123456	https://example.com/m1/96cef91ce78fa11066456db9b1275661	v:e10adc3949ba59abbe56e057f20f883e
399999	https://example.com/m1/c13ed6ac872669a72792efa1571994dc	v:6a2b50e288940201e5dd527a028ba2ad

# a user row-id IN list under a comparison
query III
SELECT i, u, v FROM t_rf WHERE rowid IN (5, 70000, 123456, 399999) AND rowid >= 70000 ORDER BY i
----
70000	https://example.com/m1/0ba7bc92fcd57e337ebb9e74308c811f	v:3078a255aee86ecc4ac1eb36b69af2f0
123456	https://example.com/m1/96cef91ce78fa11066456db9b1275661	v:e10adc3949ba59abbe56e057f20f883e
399999	https://example.com/m1/c13ed6ac872669a72792efa1571994dc	v:6a2b50e288940201e5dd527a028ba2ad

# a negative and a duplicated row id
query II
SELECT i, u FROM t_rf WHERE rowid IN (-1, 3, 3, 250000) ORDER BY i
----
3	https://example.com/m1/c4ca4238a0b923820dcc509a6f75849b
250000	https://example.com/m1/dd935e1362065ade42b17e6c3c958cc2

# a user row-id IN list of 60 values (above the threshold)
query II
SELECT count(*), sum(i)::BIGINT FROM t_rf WHERE rowid IN (1, 8, 15, 22, 29, 36, 43, 50, 57, 64, 71, 78, 85, 92, 99, 106, 113, 120, 127, 134, 141, 148, 155, 162, 169, 176, 183, 190, 197, 204, 211, 218, 225, 232, 239, 246, 253, 260, 267, 274, 281, 288, 295, 302, 309, 316, 323, 330, 337, 344, 351, 358, 365, 372, 379, 386, 393, 400, 407, 414)
----
60	12450

# row-id IN beside a filter on another column
query II
SELECT i, u FROM t_rf WHERE i IN (5, 70000, 123456) AND rowid IN (5, 70000, 399999) ORDER BY i
----
5	https://example.com/m1/c4ca4238a0b923820dcc509a6f75849b
70000	https://example.com/m1/0ba7bc92fcd57e337ebb9e74308c811f

endloop

statement ok
DELETE FROM t_rf WHERE i IN (SELECT i FROM t_rf WHERE contains(u, 'needle') ORDER BY o LIMIT 3)

