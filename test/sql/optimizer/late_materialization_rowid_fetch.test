# name: test/sql/optimizer/late_materialization_rowid_fetch.test
# description: The row-id fetch for a small row-id IN filter: a late-materialised ORDER BY ... LIMIT over a contains filter at non-consecutive row ids, LIMIT ... OFFSET, a base-table sample, LIMIT 60 (above the IN threshold), dynamic_or_filter_threshold = 0, late_materialization_max_rows = 0, user row-id IN lists (with a comparison, with missing, negative and duplicate row ids, above the threshold), and the same after a DELETE of result rows, inside a transaction with an uncommitted append and after an UPDATE of a projected column; the answers are the plain engine answers at threads 1 and 8
# group: [optimizer]

require vector_size 2048

load {TEST_DIR}/late_materialization_rowid_fetch.db readwrite v1.5.0

statement ok
CREATE TABLE t_rf(i BIGINT, o BIGINT, k INTEGER, g BIGINT, u VARCHAR USING COMPRESSION 'dict_fsst', w VARCHAR USING COMPRESSION 'dict_fsst', v VARCHAR, n1 INTEGER, n3 SMALLINT)

statement ok
INSERT INTO t_rf SELECT i::BIGINT, ((i * 7919) % 400000)::BIGINT, (i % 2048)::INTEGER, (i // 1000)::BIGINT, CASE WHEN i % 5003 = 0 THEN 'needle-' || i::VARCHAR ELSE 'https://example.com/m1/' || md5((i // 3)::VARCHAR) END, 'w' || lpad((i % 50)::VARCHAR, 2, '0'), 'v:' || md5(i::VARCHAR), (i % 997)::INTEGER, (i % 100)::SMALLINT FROM range(400000) tbl(i)

statement ok
CHECKPOINT

restart

loop t 0 2

statement ok
SET threads = CASE WHEN ${t} = 0 THEN 1 ELSE 8 END

# the late-materialised top 10: the semi join pushes ten non-consecutive row ids
query IIIIIIIII
SELECT i, o, k, g, u, w, v, n1, n3 FROM t_rf WHERE contains(u, 'needle') ORDER BY o LIMIT 10
