# name: test/sql/aggregate/aggregates/avg_double_finalize.test
# description: AVG over INTEGER, BIGINT and HUGEINT divides in double when the sum and the count are both below 2^53,
#              and in long double otherwise; every expected value here is the same on both paths and with the double
#              division switched off (exact quotients, or quotients both roundings agree on)
# group: [aggregates]

# the cases past 2^53 need a long double wider than double (x86-64, aarch64); `require longdouble` is not used because
# the runner reads LDBL_MANT_DIG without <cfloat> and skips the whole file

# small inputs of every integer type (SMALLINT keeps its own double average)
query TTTT
SELECT avg(x::SMALLINT)::VARCHAR, avg(x::INTEGER)::VARCHAR, avg(x::BIGINT)::VARCHAR, avg(x::HUGEINT)::VARCHAR
FROM (VALUES (1), (2), (3), (6)) t(x)
----
3.0	3.0	3.0	3.0

query TTTT
SELECT avg(x::SMALLINT)::VARCHAR, avg(x::INTEGER)::VARCHAR, avg(x::BIGINT)::VARCHAR, avg(x::HUGEINT)::VARCHAR
FROM (VALUES (1), (1), (2)) t(x)
----
1.3333333333333333	1.3333333333333333	1.3333333333333333	1.3333333333333333

# negative sums and NULLs
query TTT
SELECT avg(x::INTEGER)::VARCHAR, avg(x::BIGINT)::VARCHAR, avg(x::HUGEINT)::VARCHAR
FROM (VALUES (-1), (NULL), (-1), (-2), (NULL)) t(x)
----
-1.3333333333333333	-1.3333333333333333	-1.3333333333333333

query T
SELECT avg(x::BIGINT)::VARCHAR FROM (VALUES (1), (NULL), (2), (NULL), (4)) t(x)
----
2.3333333333333335

# a single row, only NULLs, no rows
query TT
SELECT avg(x::BIGINT)::VARCHAR, avg(x::HUGEINT)::VARCHAR FROM (VALUES (-7)) t(x)
----
-7.0	-7.0

query T
SELECT avg(x::BIGINT)::VARCHAR FROM (VALUES (NULL), (NULL)) t(x)
----
NULL

query T
SELECT avg(x::BIGINT)::VARCHAR FROM (SELECT 1 AS x WHERE false)
----
NULL

# grouped: sums at +-(2^53 - 1) (double), at +-2^53 and past it (long double), a NULL group
statement ok
CREATE TABLE g AS SELECT * FROM (VALUES
  (1, (1::BIGINT << 53) - 1),
  (2, -((1::BIGINT << 53) - 1)),
  (3, 1::BIGINT << 53),
  (4, -(1::BIGINT << 53)),
  (5, 1::BIGINT << 53), (5, 1), (5, 0),
  (6, -(1::BIGINT << 53)), (6, -1), (6, 0),
  (7, 1::BIGINT << 52), (7, (1::BIGINT << 52) - 1),
  (8, 1::BIGINT << 52), (8, 1::BIGINT << 52),
  (9, NULL),
  (10, 1), (10, 2)) t(g, x)

query ITTII
SELECT g, avg(x)::VARCHAR, avg(x::HUGEINT)::VARCHAR, sum(x), count(x) FROM g GROUP BY g ORDER BY g
----
1	9007199254740991.0	9007199254740991.0	9007199254740991	1
2	-9007199254740991.0	-9007199254740991.0	-9007199254740991	1
3	9007199254740992.0	9007199254740992.0	9007199254740992	1
4	-9007199254740992.0	-9007199254740992.0	-9007199254740992	1
5	3002399751580331.0	3002399751580331.0	9007199254740993	3
6	-3002399751580331.0	-3002399751580331.0	-9007199254740993	3
7	4503599627370495.5	4503599627370495.5	9007199254740991	2
8	4503599627370496.0	4503599627370496.0	9007199254740992	2
9	NULL	NULL	NULL	0
10	1.5	1.5	3	2

# ungrouped: a sum past 2^53 keeps the long double digits (a double sum would lose the + 1 first)
query T
SELECT avg(x)::VARCHAR FROM g WHERE g = 5
----
3002399751580331.0

# DECIMAL averages divide by the count times the scale, always in long double
query TTTT
SELECT avg(x::DECIMAL(4,1))::VARCHAR, avg(x::DECIMAL(9,1))::VARCHAR, avg(x::DECIMAL(18,3))::VARCHAR,
       avg(x::DECIMAL(38,2))::VARCHAR
FROM (VALUES (1.0), (1.0), (2.0)) t(x)
----
1.3333333333333333	1.3333333333333333	1.3333333333333333	1.3333333333333333

query TT
SELECT avg(x::DECIMAL(18,3))::VARCHAR, avg(x::DECIMAL(38,2))::VARCHAR FROM (VALUES (1.5), (2.25)) t(x)
----
1.875	1.875

# many groups over several threads: below 1024 rows a group's long double quotient rounds to double exactly as the
# double quotient does, so every average equals the double division of its sum by its count
query II
SELECT count(*) FILTER (WHERE a <> s / c), count(*)
FROM (SELECT i % 1000 AS g, avg(i) AS a, sum(i)::DOUBLE AS s, count(*)::DOUBLE AS c FROM range(1000000) t(i) GROUP BY g)
----
0	1000

query II
SELECT count(*) FILTER (WHERE a <> s / c), count(*)
FROM (SELECT i % 1000 AS g, avg(-i::INTEGER) AS a, sum(-i)::DOUBLE AS s, count(*)::DOUBLE AS c FROM range(1000000) t(i)
      GROUP BY g)
----
0	1000

# states carrying a count or a sum no row set of this size reaches, combined into an empty state: the exported layout is
# the count, then the sum's lower and upper words, little-endian
query T
SELECT (avg(x) EXPORT_STATE)::BLOB FROM (VALUES (-1::BIGINT), (-2::BIGINT)) t(x)
----
\x02\x00\x00\x00\x00\x00\x00\x00\xFD\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF

query II
SELECT octet_length((avg(x::INTEGER) EXPORT_STATE)::BLOB), octet_length((avg(x::HUGEINT) EXPORT_STATE)::BLOB)
FROM (VALUES (1)) t(x)
----
24	24

# 1: count and sum 2^53 - 1 (double); 2: count 2^53 - 1, sum -(2^53 - 1) (double); 3: count 2^53, sum -1;
# 4: count 2^53 + 1, sum 1 (the count is no exact double); 5: sum 2^64, count 2; 6: sum -(2^64), count 4;
# 7: sum 3 * 2^53 + 3, count 3 (the sum is no exact double): all in long double from 3 on
statement ok
CREATE TABLE s(k INTEGER, b BLOB)

statement ok
INSERT INTO s VALUES
  (1, '\xFF\xFF\xFF\xFF\xFF\xFF\x1F\x00\xFF\xFF\xFF\xFF\xFF\xFF\x1F\x00\x00\x00\x00\x00\x00\x00\x00\x00'),
  (2, '\xFF\xFF\xFF\xFF\xFF\xFF\x1F\x00\x01\x00\x00\x00\x00\x00\xE0\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF'),
  (3, '\x00\x00\x00\x00\x00\x00\x20\x00\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF'),
  (4, '\x01\x00\x00\x00\x00\x00\x20\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'),
  (5, '\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00'),
  (6, '\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF'),
  (7, '\x03\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x60\x00\x00\x00\x00\x00\x00\x00\x00\x00')

query ITTT
SELECT k, FINALIZE(COMBINE(z.a, s.b))::VARCHAR, FINALIZE(COMBINE(z.i, s.b))::VARCHAR,
       FINALIZE(COMBINE(z.h, s.b))::VARCHAR
FROM s, (SELECT avg(x) EXPORT_STATE AS a, avg(x::INTEGER) EXPORT_STATE AS i, avg(x::HUGEINT) EXPORT_STATE AS h
         FROM (SELECT 0::BIGINT AS x WHERE false)) z
ORDER BY k
----
1	1.0	1.0	1.0
2	-1.0	-1.0	-1.0
3	-1.1102230246251565e-16	-1.1102230246251565e-16	-1.1102230246251565e-16
4	1.1102230246251564e-16	1.1102230246251564e-16	1.1102230246251564e-16
5	9.223372036854776e+18	9.223372036854776e+18	9.223372036854776e+18
6	-4.611686018427388e+18	-4.611686018427388e+18	-4.611686018427388e+18
7	9007199254740992.0	9007199254740992.0	9007199254740992.0

# 4 exactly: 1 / (2^53 + 1) rounds to 2^-53 - 2^-106, below the 2^-53 a double count would give
query II
SELECT FINALIZE(COMBINE(z.a, s.b)) =
         1 / (1::BIGINT << 53)::DOUBLE - 1 / ((1::BIGINT << 53)::DOUBLE * (1::BIGINT << 53)::DOUBLE),
       FINALIZE(COMBINE(z.a, s.b)) < 1 / (1::BIGINT << 53)::DOUBLE
FROM s, (SELECT avg(x) EXPORT_STATE AS a FROM (SELECT 0::BIGINT AS x WHERE false)) z
WHERE k = 4
----
true	true
