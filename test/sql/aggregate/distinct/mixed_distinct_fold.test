# a nullable input holding NULLs: refused, the answer the general path's

statement ok
CREATE TABLE tn AS SELECT (i % 100)::INTEGER AS g, (i // 50)::BIGINT AS x, CASE WHEN i % 97 = 0 THEN NULL ELSE (i % 7)::SMALLINT END AS s FROM range(1100000) t(i);

query II
EXPLAIN SELECT g, count(DISTINCT x) AS u, count(s) AS cs, sum(s) AS ss FROM tn GROUP BY g
----
physical_plan	<!REGEX>:.*Fused Distinct Aggregate.*

query IIII
SELECT count(*)::BIGINT, sum(u)::BIGINT, sum(cs)::BIGINT, sum(ss)::BIGINT FROM (SELECT g, count(DISTINCT x) AS u, count(s) AS cs, sum(s) AS ss FROM tn GROUP BY g)
----
100	1100000	1088659	3265977

# stale plans: each statement prepared while its table holds no NULL (the fused EXPLAIN text), then a NULL inserted in g, in x, in a
# summed input and in a counted column in turn, then executed: a NULL in g, x or the summed input is a crossing that drains the
# thread (the (g, x) rows to the distinct table, the companion re-expanded into the regular sink); count(c) over a column that
# held no NULL reaches the operator as count_star() (the optimizer's count rewrite), so its NULL is no crossing; every answer
# is the general path's under the same stale plan

statement ok
CREATE TABLE ts_g AS SELECT (i % 100)::INTEGER AS g, (i // 50)::BIGINT AS x, ((i % 7) - 3)::SMALLINT AS s, (i % 13)::INTEGER AS c FROM range(1100000) t(i);

query II
EXPLAIN SELECT g, count(DISTINCT x) AS u, count(*) AS n, sum(s) AS ss, count(c) AS cc FROM ts_g GROUP BY g
----
physical_plan	<REGEX>:.*Fused Distinct Aggregate.*

statement ok
PREPARE p_g AS SELECT count(*)::BIGINT, count(g)::BIGINT, sum(u)::BIGINT, sum(n)::BIGINT, sum(ss)::BIGINT, sum(cc)::BIGINT FROM (SELECT g, count(DISTINCT x) AS u, count(*) AS n, sum(s) AS ss, count(c) AS cc FROM ts_g GROUP BY g);

statement ok
INSERT INTO ts_g VALUES (NULL, 7, 1, 2);

query IIIIII
EXECUTE p_g
----
101	101	1100001	1100001	-2	1100001

statement ok
CREATE TABLE ts_x AS SELECT (i % 100)::INTEGER AS g, (i // 50)::BIGINT AS x, ((i % 7) - 3)::SMALLINT AS s, (i % 13)::INTEGER AS c FROM range(1100000) t(i);

query II
