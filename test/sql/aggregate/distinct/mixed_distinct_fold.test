----
1000	1100000	7259996700000	12099994500000	2200000

query IIIII
SELECT g, u, sz, sb, cz FROM (SELECT g, count(DISTINCT x) AS u, sum(z) AS sz, sum(b) AS sb, count(z) AS cz FROM t1 GROUP BY g) ORDER BY g LIMIT 3
----
0	1100	7256700000	12094500000	2200
1	1100	7256706600	12094511000	2200
2	1100	7256713200	12094522000	2200

