----
physical_plan	<REGEX>:.*Fused Distinct Aggregate.*

query IIIIIII
SELECT count(*)::BIGINT, sum(u)::BIGINT, sum(sn)::BIGINT, sum(round(an * 2200))::BIGINT, sum(sm)::BIGINT, min(sn)::BIGINT, max(sn)::BIGINT FROM (SELECT g, count(DISTINCT x) AS u, sum(n) AS sn, avg(n) AS an, sum(m) AS sm FROM t1 GROUP BY g)
----
1000	1100000	-2200015	-2200015	-2200026	-2215	-2185

query IIIII
