# name: test/sql/aggregate/distinct/mixed_distinct_fold.test
# description: The mixed DISTINCT shape (one count(DISTINCT x) with one to three non-distinct aggregates of the admitted kinds,
#              none reading x): every admitted shape over >= 2^20 rows (grouped on one key, on two keys at the 12-byte key bound,
#              ungrouped; runs that fold; many groups; negative inputs and sums that do not divide), expected answers in closed
#              form (computed by the general path), an EXPLAIN per shape asserting the Fused Distinct Aggregate marker (its
#              absence on the refused twins: the shared-input shapes sum(x) and avg(x), four non-distinct aggregates,
#              avg(INTEGER), a FILTER, two distinct aggregates, a nullable input), and the stale-plan NULL cells (a NULL in g,
#              in x and in a summed input after PREPARE: the drain; a NULL in a counted column, which reaches the operator as
#              count_star(): no crossing). Every expectation of this file holds whether or not an admitted shape drains
#              (the plain EXPLAIN markers are plan-time)
# group: [distinct]

# t1: g = i % 1000 over x = i // 2000 (each g holds 2,200 rows and 1,100 distinct x); SMALLINT s, INTEGER z, BIGINT b; negative
# inputs whose group sums do not divide by 2,200: SMALLINT n in [-7, 5] and INTEGER m in [-9, 7]

statement ok
CREATE TABLE t1 AS SELECT (i % 1000)::INTEGER AS g, (i // 2000)::BIGINT AS x, (i % 7)::SMALLINT AS s, (i * 3)::INTEGER AS z, (i * 5)::BIGINT AS b, ((i % 13) - 7)::SMALLINT AS n, ((i % 17) - 9)::INTEGER AS m FROM range(2200000) t(i);

# t2: runs crossing chunk boundaries (the fold engages): g = (i // 5000) % 50, x = i // 3000, a negative SMALLINT v in [-4, 2], a
# SMALLINT w

statement ok
CREATE TABLE t2 AS SELECT ((i // 5000) % 50)::INTEGER AS g, (i // 3000)::BIGINT AS x, ((i % 7) - 4)::SMALLINT AS v, (i % 101)::SMALLINT AS w FROM range(2200000) t(i);

# t3: two SMALLINT keys and a BIGINT x (the 12-byte key region): 200 groups; SMALLINT w and a negative SMALLINT n

statement ok
CREATE TABLE t3 AS SELECT (i % 10)::SMALLINT AS g1, ((i // 10) % 20)::SMALLINT AS g2, (i // 400)::BIGINT AS x, (i % 1500)::SMALLINT AS w, ((i % 7) - 4)::SMALLINT AS n FROM range(2200000) t(i);

# t4: a SMALLINT x (the shared-input twins: sum(x), avg(x) and count(x) are admitted kinds over it) beside a SMALLINT y

statement ok
CREATE TABLE t4 AS SELECT (i % 500)::INTEGER AS g, (i % 3000)::SMALLINT AS x, (i % 17)::SMALLINT AS y FROM range(2200000) t(i);

# t5: 300,000 groups (the companion grows past its first tables): each g holds 7 or 8 distinct x

statement ok
CREATE TABLE t5 AS SELECT (i % 300000)::INTEGER AS g, (i // 300000)::BIGINT AS x, ((i % 3) - 1)::SMALLINT AS s FROM range(2200000) t(i);

# grouped, one key: count_star, sum(SMALLINT) and avg(SMALLINT) beside the distinct count

query II
EXPLAIN SELECT g, count(DISTINCT x) AS u, count(*) AS c, sum(s) AS ss, avg(s) AS a FROM t1 GROUP BY g
----
physical_plan	<REGEX>:.*Fused Distinct Aggregate.*

query IIIII
SELECT count(*)::BIGINT, sum(u)::BIGINT, sum(c)::BIGINT, sum(ss)::BIGINT, sum(round(a * c))::BIGINT FROM (SELECT g, count(DISTINCT x) AS u, count(*) AS c, sum(s) AS ss, avg(s) AS a FROM t1 GROUP BY g)
----
1000	1100000	2200000	6599995	6599995

query IIIII
SELECT g, u, c, ss, round(a * c)::BIGINT FROM (SELECT g, count(DISTINCT x) AS u, count(*) AS c, sum(s) AS ss, avg(s) AS a FROM t1 GROUP BY g) ORDER BY ss DESC, g LIMIT 3
----
6	1100	2200	6605	6605
13	1100	2200	6605	6605
20	1100	2200	6605	6605

# grouped, one key: sum_no_overflow(INTEGER), sum_no_overflow(BIGINT) and count(INTEGER) beside the distinct count

query II
