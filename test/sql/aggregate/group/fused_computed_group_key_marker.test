# name: test/sql/aggregate/group/fused_computed_group_key_marker.test
# description: Computed group keys in the fused kernel (kFusedComputedGroupKeys, kFusedSixteenByteKeys): the Fused
#              Aggregate marker with its key count on every admitted computed-key shape, absent on every refused one
# group: [group]

statement ok
CREATE TABLE tc AS SELECT ((i % 100003) * 4294967311)::BIGINT AS k, ((i % 1000003) * 7919 % 2147483647)::INTEGER AS v, TIMESTAMP '2019-07-01 00:00:00' + to_seconds((i * 37) % 31622400) AS ts, (CASE WHEN i % 1000 = 7 THEN NULL ELSE TIMESTAMP '2019-07-01 00:00:00' + to_seconds((i * 37) % 31622400) END) AS tn, (CASE WHEN i % 1000 = 7 THEN 'infinity'::TIMESTAMP ELSE TIMESTAMP '2019-07-01 00:00:00' + to_seconds((i * 37) % 31622400) END) AS ti, (i % 128)::INTEGER AS s, (i % 129)::INTEGER AS s2, (i % 129)::SMALLINT AS s3, (i % 1000)::INTEGER AS w, (i % 100003)::BIGINT AS b FROM range(2200000) t(i)

# minute(ts) beside a BIGINT key: 9 key bytes (8 + a 0-59 minute compressed to UTINYINT)
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, minute(ts) AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2 .*

# hour(ts) beside a BIGINT key
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, hour(ts) AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2 .*

# second(ts) beside a BIGINT key
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, second(ts) AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2 .*

# minute(ts) alone: 60 groups, the planner's perfect-hash aggregate (no hash aggregate to attach to)
query II
EXPLAIN (FORMAT JSON) SELECT minute(ts) AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<!REGEX>:.*Fused Aggregate.*

# b * 3 alone: one computed key, a BIGINT product (0-300006) compressed to UINTEGER
query II
EXPLAIN (FORMAT JSON) SELECT b * 3 AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=1 .*

# BIGINT + minute(ts) + INTEGER = 13 key bytes, three keys (the 16-byte region)
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, minute(ts) AS g, v AS v, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=3 .*

# the computed key first
query II
EXPLAIN (FORMAT JSON) SELECT minute(ts) AS g, k AS k, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2 .*

# year(ts): the function's statistics from the column's minimum and maximum (2019-2020), compressed with a constant
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, year(ts) AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2 .*

# dayofyear(ts): 1-366, a range past 255, compressed to USMALLINT (2 key bytes)
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, dayofyear(ts) AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2 .*

# an arithmetic computed key, s * 2 over INTEGER 0-127: 0-254, the UTINYINT edge
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, s * 2 AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2 .*

# s2 * 2 over INTEGER 0-128: 0-256, one past the UTINYINT edge (USMALLINT)
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, s2 * 2 AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2 .*

# s3 * 2 over SMALLINT 0-128: 0-256 has no narrower type, so no compress is planned; a bare computed key, refused
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, s3 * 2 AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<!REGEX>:.*Fused Aggregate.*

# minute(ts) with count(w) and sum(s) beside count(*)
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, minute(ts) AS g, count(*) AS c, count(w) AS cw, sum(s) AS ss FROM tc GROUP BY ALL
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2 .*

# date_trunc('hour', ts): a TIMESTAMP key, never compressed, so refused (the generic aggregate answers)
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, date_trunc('hour', ts) AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<!REGEX>:.*Fused Aggregate.*

# minute(tn) over a column with NULLs: the key can hold NULL, refused
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, minute(tn) AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<!REGEX>:.*Fused Aggregate.*

# minute(ti) over a column holding 'infinity': the function's range cannot be bounded (an infinity's minute is NULL), refused
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, minute(ti) AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<!REGEX>:.*Fused Aggregate.*

# w // 7: no statistics callback, so no bounded range and no compress; refused
query II
EXPLAIN (FORMAT JSON) SELECT k AS k, w // 7 AS g, count(*) AS c FROM tc GROUP BY ALL
----
physical_plan	<!REGEX>:.*Fused Aggregate.*
