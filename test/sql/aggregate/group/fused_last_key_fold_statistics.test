# name: test/sql/aggregate/group/fused_last_key_fold_statistics.test
# description: The last-key fold's statistics guard (kFusedLastKeyFoldStatisticsGuard) over >= 2^20 rows: a two-key shape
#              whose BIGINT column is unique by its distinct-count statistic (the count would widen the row 16 -> 20
#              bytes with nothing to fold) is refused the fold; a repeated key and a filtered input (the statistics
#              describe the whole table) keep it. Every expected answer is upstream DuckDB's on the same table, with or
#              without the fold
# group: [group]

statement ok
CREATE TABLE t AS SELECT (i * 2654435761)::BIGINT AS u, (i % 1000)::INTEGER AS w, ((i // 4) * 4294967311)::BIGINT AS r4, ((i // 4) % 1000)::INTEGER AS r4b FROM range(2200000) t(i)

statement ok
CREATE TABLE tf AS SELECT (i * 2654435761)::BIGINT AS u, (i % 1000)::INTEGER AS w, (i % 7)::INTEGER AS y FROM range(6000000) t(i)

# a unique BIGINT beside an INTEGER: the fused kernel, never the fold
query II
EXPLAIN (FORMAT JSON) SELECT u, w, count(*) AS c FROM t GROUP BY u, w
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2.*

query II
EXPLAIN (FORMAT JSON) SELECT u, w, count(*) AS c FROM t GROUP BY u, w
----
physical_plan	<!REGEX>:.*fold=last_key.*

# runs of 4 on a BIGINT + INTEGER key: the fold
query II
EXPLAIN (FORMAT JSON) SELECT r4, r4b, count(*) AS c FROM t GROUP BY r4, r4b
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2[^"]*fold=last_key.*

# the unique BIGINT beside an INTEGER under a filter: the statistics are not read, the fold stands
query II
EXPLAIN (FORMAT JSON) SELECT u, w, count(*) AS c FROM tf WHERE y <> 3 GROUP BY u, w
----
physical_plan	<REGEX>:.*"Fused Aggregate": "[^"]*keys=2[^"]*fold=last_key.*

foreach threads 1 8

statement ok
SET threads=${threads}

# every key unique
query IIIII
SELECT count(*)::BIGINT, sum(c)::BIGINT, min(c), max(c), sum(hash(u, w, c))::HUGEINT FROM (SELECT u, w, count(*) AS c FROM t GROUP BY u, w)
----
2200000	2200000	1	1	20301455133192001297130518

# runs of 4 on a BIGINT + INTEGER key
query IIIII
SELECT count(*)::BIGINT, sum(c)::BIGINT, min(c), max(c), sum(hash(r4, r4b, c))::HUGEINT FROM (SELECT r4, r4b, count(*) AS c FROM t GROUP BY r4, r4b)
----
550000	2200000	4	4	5075869180113886419593911

# a unique BIGINT beside an INTEGER under a filter
query IIIII
SELECT count(*)::BIGINT, sum(c)::BIGINT, min(c), max(c), sum(hash(u, w, c))::HUGEINT FROM (SELECT u, w, count(*) AS c FROM tf WHERE y <> 3 GROUP BY u, w)
----
5142857	5142857	1	1	47453093339145665128450247

endloop
