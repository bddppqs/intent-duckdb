# name: test/sql/aggregate/group/dict_global_sink.test
# description: Borrowed group keys over a published global dictionary match the regular sink
# group: [group]

# Group keys over a published dictionary are borrowed, and a lone key takes the row path with the borrow; every answer equals the regular sink's

statement ok
ATTACH '__TEST_DIR__/dict_global_sink.db' AS globaldict (STORAGE_VERSION 'v1.5.0')

statement ok
USE globaldict

statement ok
SET force_compression='dict_fsst'

statement ok
CREATE TABLE docs AS SELECT i AS id, (i % 13)::SMALLINT AS cat, (hash(i) % 5000)::BIGINT AS owner, CASE WHEN i % 97 = 0 THEN NULL ELSE 'https://www.example.org/globaldict/some/long/path/' || (hash(i // 3) % 20000)::VARCHAR END AS addr, CASE WHEN i % 5 = 0 THEN '' ELSE 'catalogue item number ' || (hash(i // 2) % 3000)::VARCHAR END AS terms, 'topic-of-the-page-number-' || (i % 211)::VARCHAR AS label FROM range(400000) r(i)

statement ok
CHECKPOINT

statement ok
SET threads=1

query II
SELECT addr, count(*) AS c FROM docs GROUP BY addr ORDER BY c DESC, addr LIMIT 5
----
NULL	4124
https://www.example.org/globaldict/some/long/path/7646	53
https://www.example.org/globaldict/some/long/path/13103	52
https://www.example.org/globaldict/some/long/path/14090	51
https://www.example.org/globaldict/some/long/path/4378	51

query II
SELECT sum(hash(addr, c)), count(*) FROM (SELECT addr, count(*) c FROM docs GROUP BY addr)
----
184977460081451630916906	19980

query II
SELECT sum(hash(x, u, c)), count(*) FROM (SELECT 1 x, addr u, count(*) c FROM docs GROUP BY 1, 2)
----
184413290471955115408706	19980

query II
SELECT sum(hash(u, s, c)), count(*) FROM (SELECT owner u, terms s, count(*) c FROM docs GROUP BY ALL)
----
2865061564015308959462719	310904

query II
SELECT sum(hash(u, t, c)), count(*) FROM (SELECT addr u, label t, count(*) c FROM docs GROUP BY ALL)
----
3486223849428750214349499	377922

query II
SELECT sum(hash(s, u)), count(*) FROM (SELECT terms s, count(DISTINCT owner) u FROM docs WHERE terms <> '' GROUP BY ALL)
----
27621437640244004523862	3000

query II
SELECT sum(hash(u, m, c)), count(*) FROM (SELECT addr u, min(addr) m, count(*) c FROM docs GROUP BY addr)
----
185219013228939456380408	19980

query II
SELECT addr IS NULL AS n, count(*) FROM (SELECT addr FROM docs GROUP BY addr) GROUP BY 1 ORDER BY 1
----
false	19979
true	1

query III
SELECT addr, label, count(*) FROM docs GROUP BY GROUPING SETS ((addr), (label)) ORDER BY 3 DESC, 1, 2 LIMIT 5
----
NULL	NULL	4124
NULL	topic-of-the-page-number-0	1896
NULL	topic-of-the-page-number-1	1896
NULL	topic-of-the-page-number-10	1896
NULL	topic-of-the-page-number-100	1896

query II
SELECT label, count(*) AS c FROM docs GROUP BY label HAVING count(*) > 1896 ORDER BY c DESC, label LIMIT 5
----

query II
SELECT terms, count(*) AS c FROM docs WHERE terms <> '' GROUP BY terms ORDER BY c DESC, terms LIMIT 5
----
catalogue item number 63	159
catalogue item number 2096	158
catalogue item number 2881	158
catalogue item number 1990	153
catalogue item number 1516	149

query I
SELECT count(*) FROM (SELECT DISTINCT addr FROM docs)
----
19980

query I
SELECT count(*) FROM (SELECT DISTINCT addr, label FROM docs)
----
377922

