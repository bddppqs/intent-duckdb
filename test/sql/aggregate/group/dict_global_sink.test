statement ok
RESET threads

# Every alter path invalidates the table's column dictionaries - the altered table shares the DataTableInfo, and DROP COLUMN renumbers the storage indexes (addr 3 -> 2, terms 4 -> 3, label 5 -> 4); a dictionary published before an ALTER is never found for another column, and every answer equals the general aggregate's

statement ok
SET threads=1

query II
SELECT terms, count(*) AS c FROM docs WHERE terms <> '' GROUP BY terms ORDER BY c DESC, terms LIMIT 5
----
catalogue item number 63	159
catalogue item number 2096	158
catalogue item number 2881	158
catalogue item number 1990	153
catalogue item number 1516	149

query II
SELECT sum(hash(u, c)), count(*) FROM (SELECT addr u, count(*) c FROM docs GROUP BY addr)
----
184977460081451630916906	19980

statement ok
ALTER TABLE docs DROP COLUMN cat

statement ok
ALTER TABLE docs ADD COLUMN extra VARCHAR DEFAULT 'an added column'

statement ok
ALTER TABLE docs RENAME COLUMN terms TO word

statement ok
ALTER TABLE docs RENAME COLUMN label TO terms

statement ok
SET threads=1

