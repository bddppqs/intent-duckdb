# count(k) over a key that can hold NULL stays the unary aggregate, which never carries the run channel (over a key
# without NULLs the planner turns count(k) into count_star())
query II
EXPLAIN (FORMAT JSON) SELECT k, count(k) AS c FROM t_null GROUP BY k;
----
physical_plan	<!REGEX>:.*Run Aggregate.*
