# name: test/sql/aggregate/group/run_channel_fused.test
# description: The run kind of the fused integer aggregate: a COUNT(*) GROUP BY over one run-eligible integer key
#              whose plan carries the grouped run channel attaches the kernel in run kind (the EXPLAIN text
#              kind=run, read from EXPLAIN (FORMAT JSON)); its answers equal the count(k) twin and closed-form
#              summaries; the refused shapes keep the regular run path. No require line.
# group: [group]

# t_big: a BIGINT key in runs of 4, its range past 2^32 (no compressed key)
statement ok
CREATE TABLE t_big(k BIGINT USING COMPRESSION 'rle');

statement ok
INSERT INTO t_big SELECT ((i // 4) * 4294967311)::BIGINT FROM range(2097152) t(i);

# t_int: an INTEGER key in runs of 3 over the full range
statement ok
CREATE TABLE t_int(k INTEGER USING COMPRESSION 'rle');

statement ok
INSERT INTO t_int SELECT ((i // 3) * 7919 % 2147483647)::INTEGER FROM range(2097152) t(i);

# t_small: a SMALLINT key in runs of 5 over 60,000 values (past the perfect-hash range)
statement ok
CREATE TABLE t_small(k SMALLINT USING COMPRESSION 'rle');

statement ok
INSERT INTO t_small SELECT ((i // 5) % 60000 - 30000)::SMALLINT FROM range(2097152) t(i);

# t_usmall: a USMALLINT key in runs of 7
statement ok
CREATE TABLE t_usmall(k USMALLINT USING COMPRESSION 'rle');

statement ok
INSERT INTO t_usmall SELECT ((i // 7) % 60000)::USMALLINT FROM range(2097152) t(i);

# t_uint: a UINTEGER key in runs of 2
statement ok
CREATE TABLE t_uint(k UINTEGER USING COMPRESSION 'rle');

statement ok
INSERT INTO t_uint SELECT ((i // 2) * 2654435761 % 4294967291)::UINTEGER FROM range(2097152) t(i);

# t_ubig: a UBIGINT key in runs of 6
statement ok
CREATE TABLE t_ubig(k UBIGINT USING COMPRESSION 'rle');

statement ok
INSERT INTO t_ubig SELECT ((i // 6) * 4294967311)::UBIGINT FROM range(2097152) t(i);

# t_straddle: runs of 3,000, 65,535 (the rle_count_t cap), 70,000, 122,880 (a row group), 2,047 and 2,049 rows, then runs of 1,000: every run crossing a vector, a stored entry, a segment or a row-group boundary arrives as several run rows for one key and folds
statement ok
CREATE TABLE t_straddle(k BIGINT USING COMPRESSION 'rle');

statement ok
INSERT INTO t_straddle SELECT (CASE WHEN i < 3000 THEN 1 WHEN i < 68535 THEN 2 WHEN i < 138535 THEN 3 WHEN i < 261415 THEN 4 WHEN i < 263462 THEN 5 WHEN i < 265511 THEN 6 ELSE 7 + (i - 265511) // 1000 END * 4294967311)::BIGINT FROM range(1200000) t(i);

# t_floor: 2^19 rows, under the 2^20 floor - the regular run path (Run Aggregate alone)
statement ok
CREATE TABLE t_floor(k BIGINT USING COMPRESSION 'rle');

statement ok
INSERT INTO t_floor SELECT ((i // 4) * 4294967311)::BIGINT FROM range(524288) t(i);

# t_null: a key that can hold NULL - the regular run path (its NULL-bearing vectors take the ordinary scan)
statement ok
CREATE TABLE t_null(k BIGINT USING COMPRESSION 'rle');

statement ok
INSERT INTO t_null SELECT CASE WHEN i % 100000 = 7 THEN NULL ELSE ((i // 4) * 4294967311)::BIGINT END FROM range(2097152) t(i);

# t_tiny: a TINYINT key: never run kind (the perfect-hash aggregate takes it; the kernel refuses INT8 besides)
statement ok
CREATE TABLE t_tiny(k TINYINT USING COMPRESSION 'rle');

statement ok
INSERT INTO t_tiny SELECT ((i // 4) % 200 - 100)::TINYINT FROM range(2097152) t(i);

statement ok
CHECKPOINT;

# ---------------------------------------------------------------------------------------------------------------
# engaged: the EXPLAIN text kind=run beside the scan-side Run Aggregate; answers against closed-form summaries and the twin
# ---------------------------------------------------------------------------------------------------------------
query II
EXPLAIN (FORMAT JSON) SELECT k, count(*) AS c FROM t_big GROUP BY k;
----
physical_plan	<REGEX>:.*Run Aggregate.*kind=run.*

query IIIIIII
SELECT count(*), sum(c), min(c), max(c), sum(k::HUGEINT * c), min(k), max(k) FROM (SELECT k, count(*) AS c FROM t_big GROUP BY k);
----
524288	2097152	4	4	2361178746081516716032	0	2251795526582257

query I
SELECT count(*) FROM ((SELECT k, count(*) AS c FROM t_big GROUP BY k EXCEPT ALL SELECT k, count(k) AS c FROM t_big GROUP BY k) UNION ALL (SELECT k, count(k) AS c FROM t_big GROUP BY k EXCEPT ALL SELECT k, count(*) AS c FROM t_big GROUP BY k));
----
0

query II
SELECT k, count(*) AS c FROM t_big GROUP BY k ORDER BY c DESC, k LIMIT 3;
----
0	4
4294967311	4
8589934622	4

