statement ok
INSERT INTO docs SELECT 500000 + i, 2, 2, 'https://www.example.org/globaldict/some/long/path/' || 'appended-' || (i % 7)::VARCHAR, 'catalogue item number ' || (i % 5)::VARCHAR, 'topic-of-the-page-number-5' FROM range(3000) r(i)

