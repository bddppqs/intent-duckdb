query III
SELECT t.label, t.c, h.n FROM (SELECT label, count(*) c FROM docs GROUP BY label) t JOIN (SELECT label, max(id) n FROM docs GROUP BY label) h ON t.label = h.label ORDER BY t.c DESC, t.label LIMIT 5
